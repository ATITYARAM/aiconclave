---
const { title, eyebrow, heading, intro } = Astro.props;
const nav = [
  ['Announcement', '/aiconclave/announcement/'],
  ['About', '/aiconclave/about/'],
  ['Tracks', '/aiconclave/tracks/'],
  ['Event Plan', '/aiconclave/event-plan/'],
  ['Showcase', '/aiconclave/showcase/'],
  ['Challenge', '/aiconclave/challenge/'],
  ['Workshops', '/aiconclave/workshops/']
];
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title} · HPC Innovation Conclave 2027</title>
</head>
<body>
  <header class="site-header">
    <nav aria-label="Main navigation">
      {nav.map(([label, href]) => <a href={href}>{label}</a>)}
    </nav>
  </header>
  <main>
    <section class="page-hero">
      <p class="eyebrow">{eyebrow}</p>
      <h1>{heading}</h1>
      <p class="intro">{intro}</p>
    </section>
    <section class="content"><slot /></section>
  </main>
  <footer><span>HPC INNOVATION CONCLAVE 2027</span><span>05–06 FEB 2027 · KEC</span></footer>
</body>
</html>
<style>
:global(*){box-sizing:border-box}:global(body){margin:0;background:#f7f6f2;color:#161616;font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;padding-top:88px}.site-header{position:fixed;top:18px;left:50%;transform:translateX(-50%);z-index:80;width:min(980px,calc(100% - 30px));padding:12px 14px;display:flex;justify-content:center;align-items:center;border:1px solid #d3d0c8;border-radius:16px;background:rgba(255,255,252,.94);backdrop-filter:blur(18px);box-shadow:0 14px 42px rgba(35,35,30,.12)}.site-header nav{display:flex;justify-content:center;align-items:center;flex-wrap:wrap;gap:8px 22px}.site-header nav a{color:#68655f;text-decoration:none;font-size:13px;font-weight:750;letter-spacing:.04em;white-space:nowrap}.site-header nav a:hover{color:#2f708f}.page-hero{width:min(1180px,calc(100% - 44px));margin:auto;padding:120px 0 100px;border-bottom:1px solid #d7d5ce}.eyebrow,.content .label{margin:0;color:#31708f;font-size:11px;font-weight:850;letter-spacing:.18em;text-transform:uppercase}.page-hero h1{max-width:950px;margin:20px 0 30px;font-size:clamp(64px,9vw,140px);line-height:.86;letter-spacing:-.075em}.page-hero h1 em{color:#2f708f;font-family:Georgia,serif;font-weight:400}.intro{max-width:780px;margin:0;color:#66635d;font-size:clamp(18px,1.7vw,21px);line-height:1.7}.content{width:min(1180px,calc(100% - 44px));margin:auto;padding:85px 0 140px}.content h2{font-size:clamp(36px,5vw,68px);line-height:.95;letter-spacing:-.06em;margin:0 0 24px}.content h2 em{color:#2f708f;font-family:Georgia,serif;font-weight:400}.content p{color:#66635d;line-height:1.8;font-size:17px}.grid{display:grid;grid-template-columns:repeat(2,1fr);gap:1px;background:#d7d5ce;border:1px solid #d7d5ce}.card{background:#fbfaf7;padding:32px}.card small{display:block;color:#31708f;font-size:11px;font-weight:850;letter-spacing:.14em;text-transform:uppercase}.card h3{margin:12px 0 10px;font-size:29px;letter-spacing:-.04em}.card p{margin:0;font-size:16px}.big-list{border-top:1px solid #d7d5ce}.row{display:grid;grid-template-columns:70px 1fr auto;gap:22px;padding:30px 0;border-bottom:1px solid #d7d5ce;align-items:center}.row .num{color:#8b8881;font-size:13px}.row h3{margin:0 0 8px;font-size:31px;letter-spacing:-.04em}.row p{margin:0;font-size:15px}.fee{color:#2f708f;font-size:15px}.rules{margin-top:32px;padding:24px;border:1px solid #d7d5ce;background:#fbfaf7}.rules strong{display:block;margin-bottom:11px;font-size:16px}.rules span{display:block;color:#66635d;font-size:15px;line-height:1.75}footer{width:min(1180px,calc(100% - 44px));margin:auto;padding:25px 0 115px;border-top:1px solid #d7d5ce;display:flex;justify-content:space-between;color:#77746e;font-size:11px;letter-spacing:.14em}@media(max-width:760px){.site-header{top:10px;width:calc(100% - 20px);padding:10px 12px;justify-content:flex-start;overflow-x:auto;scrollbar-width:none}.site-header::-webkit-scrollbar{display:none}.site-header nav{justify-content:flex-start;flex-wrap:nowrap;gap:9px 17px;min-width:max-content}.site-header nav a{font-size:12px}.page-hero,.content{width:min(100% - 30px,1180px)}.page-hero{padding:80px 0 70px}.page-hero h1{font-size:clamp(58px,16vw,100px)}.intro{font-size:17px}.grid{grid-template-columns:1fr}.row{grid-template-columns:35px 1fr}.fee{grid-column:2}.content p{font-size:16px}}
</style>
