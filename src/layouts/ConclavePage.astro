-size:31px;letter-spacing:-.04em}.card p{margin:0;font-size:17px}.big-list{border-top:1px solid #232b36}.row{display:grid;grid-template-columns:70px 1fr auto;gap:22px;padding:30px 0;border-bottom:1px solid #232b36;align-items:center}.row .num{color:#68727e;font-size:14px}.row h3{margin:0 0 8px;font-size:32px;letter-spacing:-.04em}.row p{margin:0;font-size:16px}.fee{color:#3fd2c4;font-size:16px;font-weight:700}.rules{margin-top:32px;padding:24px;border:1px solid #232b36;background:#12171f}.rules strong{display:block;margin-bottom:11px;font-size:17px}.rules span{display:block;color:#96a0ac;font-size:16px;line-height:1.75}.card-linkable{cursor:pointer}.card-linkable:focus-visible{outline:2px solid #3fd2c4;outline-offset:4px}.registration-bar{position:fixed;left:50%;bottom:18px;transform:translateX(-50%);z-index:90;width:min(760px,calc(100% - 30px));padding:12px 14px 12px 18px;display:flex;align-items:center;justify-content:space-between;gap:18px;border:1px solid #232b36;border-radius:18px;background:rgba(12,16,22,.96);backdrop-filter:blur(18px);box-shadow:0 18px 48px rgba(0,0,0,.42)}.registration-bar>div{display:flex;align-items:baseline;gap:12px;min-width:0}.registration-bar span:first-child{color:#7d8792;font-size:10px;font-weight:800;letter-spacing:.12em;white-space:nowrap}.registration-bar strong{font-size:14px;letter-spacing:-.01em}.register-button{display:inline-flex;align-items:center;justify-content:center;gap:18px;flex:0 0 auto;padding:11px 17px;border-radius:11px;background:#e9eef4;color:#06211d;text-decoration:none;font-size:13px;font-weight:800}.register-button:hover{background:#3fd2c4}.register-button span{font-size:16px}@media(max-width:760px){.site-header{top:10px;width:calc(100% - 20px);padding:11px 13px;justify-content:flex-start;overflow-x:auto;scrollbar-width:none}.site-header::-webkit-scrollbar{display:none}.site-header nav{justify-content:flex-start;flex-wrap:nowrap;gap:9px 17px;min-width:max-content}.site-header nav a{font-size:13px}.page-hero,.content{width:min(100% - 30px,1180px)}.page-hero{padding:80px 0 70px}.page-hero h1{font-size:clamp(58px,16vw,100px)}.intro{font-size:18px}.grid{grid-template-columns:1fr}.row{grid-template-columns:35px 1fr}.fee{grid-column:2}.content p{font-size:17px}.registration-bar{bottom:10px;width:calc(100% - 20px);padding:10px}.registration-bar>div{display:block}.registration-bar span:first-child{display:block;margin-bottom:2px}.registration-bar strong{font-size:13px}.register-button{padding:10px 13px}}
</style>
