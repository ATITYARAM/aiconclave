---
const { title, eyebrow, heading, intro } = Astro.props;
const nav = [
  ['Announcement', '/aiconclave/announcement/'],
  ['About', '/aiconclave/about/'],
  ['Tracks', '/aiconclave/tracks/'],
  ['Event Plan', '/aiconclave/event-plan/'],
  ['Showcase', '/aiconclave/showcase/'],
  ['Challenge', '/aiconclave/challenge/'],
  ['Workshops', '/aiconclave/workshops/']
];
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title} · HPC Innovation Conclave 2027</title>
</head>
<body>
  <header class="site-header">
    <nav aria-label="Main navigation">
      {nav.map(([label, href]) => <a href={href}>{label}</a>)}
    </nav>
  </header>
  <main>
    <section class="page-hero">
      <p class="eyebrow">{eyebrow}</p>
      <h1>{heading}</h1>
      <p class="intro">{intro}</p>
    </section>
    <section class="content"><slot /></section>
  </main>
  <footer><span>HPC INNOVATION CONCLAVE 2027</span><span>05–06 FEB 2027 · KEC</span></footer>

  <div class="registration-bar">
    <div>
      <span>HPC INNOVATION CONCLAVE 2027</span>
      <strong>Choose your track</strong>
    </div>
    <a class="register-button" href="/aiconclave/registration-details/" aria-label="Register for HPC Innovation Conclave 2027">Register <span>↗</span></a>
  </div>

  <script>
    const routes = {
      eventPlan: '/aiconclave/event-plan/',
      showcase: '/aiconclave/showcase/',
      challenge: '/aiconclave/challenge/',
      workshops: '/aiconclave/workshops/'
    };

    const makeClickable = (card, href) => {
      if (!card || card.dataset.cardLink) return;
      card.dataset.cardLink = href;
      card.classList.add('card-linkable');
      card.setAttribute('role', 'link');
      card.setAttribute('tabindex', '0');
      const heading = card.querySelector('h2, h3');
      if (heading) card.setAttribute('aria-label', `Open ${heading.textContent.trim()}`);
      card.addEventListener('click', (event) => {
        if (event.target.closest('a, button')) return;
        window.location.href = href;
      });
      card.addEventListener('keydown', (event) => {
        if (event.key === 'Enter' || event.key === ' ') {
          event.preventDefault();
          window.location.href = href;
        }
      });
    };

    document.querySelectorAll('.day-card').forEach((card) => makeClickable(card, routes.eventPlan));

    document.querySelectorAll('.track-card').forEach((card) => {
      const text = card.textContent.toLowerCase();
      if (text.includes('showcase')) makeClickable(card, routes.showcase);
      else if (text.includes('challenge')) makeClickable(card, routes.challenge);
      else if (text.includes('workshop')) makeClickable(card, routes.workshops);
    });

    document.querySelectorAll('.schedule-card').forEach((card) => {
      const text = card.textContent.toLowerCase();
      if (text.includes('gpu computing') || text.includes('genai & llms on hpc')) makeClickable(card, routes.workshops);
      else if (text.includes('hpc industry innovation showcase — session i') || text.includes('showcase session ii')) makeClickable(card, routes.showcase);
      else if (/challenge continues( non-stop)?\b/.test(text) && !text.includes('showcase')) makeClickable(card, routes.challenge);
    });

    document.querySelectorAll('.programme-card').forEach((card) => {
      const text = card.textContent.toLowerCase();
      if (text.includes('workshop')) makeClickable(card, routes.workshops);
      else if (text.includes('24-hour industry innovation challenge')) makeClickable(card, routes.challenge);
      else if (text.includes('innovation showcase')) makeClickable(card, routes.showcase);
    });
  </script>
</body>
</html>
<style>
@import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700;800&display=swap');
