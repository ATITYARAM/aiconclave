---
const { title, eyebrow, heading, intro, children } = Astro.props;
const nav = [
  ['Announcement', '/aiconclave/announcement/'],
  ['About', '/aiconclave/about/'],
  ['Tracks', '/aiconclave/tracks/'],
  ['Event Plan', '/aiconclave/event-plan/'],
  ['Showcase', '/aiconclave/showcase/'],
  ['Challenge', '/aiconclave/challenge/'],
  ['Workshops', '/aiconclave/workshops/'],
  ['Registration', '/aiconclave/registration/']
];
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title} · HPC Innovation Conclave 2027</title>
</head>
<body>
  <header class="site-header">
    <a class="brand" href="/aiconclave/">HPC INNOVATION CONCLAVE 2027</a>
    <nav aria-label="Main navigation">
      {nav.map(([label, href]) => <a href={href}>{label}</a>)}
    </nav>
  </header>
  <main>
    <section class="page-hero">
      <p class="eyebrow">{eyebrow}</p>
      <h1>{heading}</h1>
      <p class="intro">{intro}</p>
    </section>
    <section class="content"><slot /></section>
  </main>
  <footer><span>HPC INNOVATION CONCLAVE 2027</span><span>05–06 FEB 2027 · KEC</span></footer>
</body>
</html>
<style>
:global(*){box-sizing:border-box}:global(body){margin:0;background:#f7f6f2;color:#161616;font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif}.site-header{position:sticky;top:0;z-index:10;width:min(1180px,calc(100% - 44px));margin:auto;padding:20px 0 17px;display:flex;justify-content:space-between;align-items:center;gap:24px;background:rgba(247,246,242,.92);backdrop-filter:blur(14px);border-bottom:1px solid #d7d5ce}.brand{color:#161616;text-decoration:none;font-size:10px;font-weight:850;letter-spacing:.14em;white-space:nowrap}.site-header nav{display:flex;flex-wrap:wrap;justify-content:flex-end;gap:8px 20px}.site-header nav a{color:#68655f;text-decoration:none;font-size:10px;font-weight:700;letter-spacing:.07em}.site-header nav a:hover{color:#2f708f}.page-hero{width:min(1180px,calc(100% - 44px));margin:auto;padding:105px 0 90px;border-bottom:1px solid #d7d5ce}.eyebrow,.content .label{margin:0;color:#31708f;font-size:10px;font-weight:850;letter-spacing:.2em;text-transform:uppercase}.page-hero h1{max-width:900px;margin:18px 0 25px;font-size:clamp(56px,9vw,120px);line-height:.86;letter-spacing:-.075em}.page-hero h1 em{color:#2f708f;font-family:Georgia,serif;font-weight:400}.intro{max-width:720px;margin:0;color:#66635d;font-size:clamp(16px,1.6vw,19px);line-height:1.65}.content{width:min(1180px,calc(100% - 44px));margin:auto;padding:75px 0 130px}.content h2{font-size:clamp(30px,5vw,62px);line-height:.95;letter-spacing:-.06em;margin:0 0 22px}.content h2 em{color:#2f708f;font-family:Georgia,serif;font-weight:400}.content p{color:#66635d;line-height:1.75;font-size:15px}.grid{display:grid;grid-template-columns:repeat(2,1fr);gap:1px;background:#d7d5ce;border:1px solid #d7d5ce}.card{background:#fbfaf7;padding:28px}.card small{display:block;color:#31708f;font-size:9px;font-weight:850;letter-spacing:.15em;text-transform:uppercase}.card h3{margin:10px 0 8px;font-size:24px;letter-spacing:-.04em}.card p{margin:0;font-size:13px}.big-list{border-top:1px solid #d7d5ce}.row{display:grid;grid-template-columns:70px 1fr auto;gap:20px;padding:26px 0;border-bottom:1px solid #d7d5ce;align-items:center}.row .num{color:#8b8881;font-size:11px}.row h3{margin:0 0 6px;font-size:27px;letter-spacing:-.04em}.row p{margin:0;font-size:12px}.fee{color:#2f708f;font-size:13px}.rules{margin-top:28px;padding:20px;border:1px solid #d7d5ce;background:#fbfaf7}.rules strong{display:block;margin-bottom:10px}.rules span{display:block;color:#66635d;font-size:13px;line-height:1.7}footer{width:min(1180px,calc(100% - 44px));margin:auto;padding:22px 0 110px;border-top:1px solid #d7d5ce;display:flex;justify-content:space-between;color:#77746e;font-size:9px;letter-spacing:.16em}@media(max-width:760px){.site-header{align-items:flex-start;flex-direction:column}.site-header nav{justify-content:flex-start}.page-hero,.content{width:min(100% - 30px,1180px)}.grid{grid-template-columns:1fr}.row{grid-template-columns:35px 1fr}.fee{grid-column:2}.page-hero{padding:75px 0 65px}}
</style>
