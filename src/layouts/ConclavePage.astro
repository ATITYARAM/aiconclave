---
const { title, eyebrow, heading, intro } = Astro.props;
const nav = [
  ['Announcement', '/aiconclave/announcement/'],
  ['About', '/aiconclave/about/'],
  ['Tracks', '/aiconclave/tracks/'],
  ['Event Plan', '/aiconclave/event-plan/'],
  ['Showcase', '/aiconclave/showcase/'],
  ['Challenge', '/aiconclave/challenge/'],
  ['Workshops', '/aiconclave/workshops/']
];
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="theme-color" content="#f7f6f2" />
  <title>{title} · HPC Innovation Conclave 2027</title>
</head>
<body>
  <a class="skip-link" href="#main-content">Skip to content</a>
  <header class="site-header">
    <nav aria-label="Main navigation">
      {nav.map(([label, href]) => <a href={href}>{label}</a>)}
    </nav>
  </header>
  <main id="main-content">
    <section class="page-hero">
      <div class="hero-grid" aria-hidden="true"></div>
      <p class="eyebrow">{eyebrow}</p>
      <h1>{heading}</h1>
      <p class="intro">{intro}</p>
    </section>
    <section class="content"><slot /></section>
  </main>
  <footer><span>HPC INNOVATION CONCLAVE 2027</span><span>05–06 FEB 2027 · KEC</span></footer>

  <div class="registration-bar" aria-label="Registration call to action">
    <div>
      <span>HPC INNOVATION CONCLAVE 2027</span>
      <strong>Choose your track</strong>
    </div>
    <a class="register-button" href="/aiconclave/registration-details/" aria-label="Register for HPC Innovation Conclave 2027">Register <span aria-hidden="true">↗</span></a>
  </div>

  <script>
    const routes = {
      eventPlan: '/aiconclave/event-plan/',
      showcase: '/aiconclave/showcase/',
      challenge: '/aiconclave/challenge/',
      workshops: '/aiconclave/workshops/'
    };

    const currentPath = window.location.pathname.replace(/\/+$/, '') || '/';
    document.querySelectorAll('.site-header nav a').forEach((link) => {
      const href = new URL(link.href).pathname.replace(/\/+$/, '') || '/';
      if (href === currentPath) link.setAttribute('aria-current', 'page');
    });

    requestAnimationFrame(() => document.body.classList.add('is-ready'));

    const makeClickable = (card, href) => {
      if (!card || card.dataset.cardLink) return;
      card.dataset.cardLink = href;
      card.classList.add('card-linkable');
      card.setAttribute('role', 'link');
      card.setAttribute('tabindex', '0');
      const heading = card.querySelector('h2, h3');
      if (heading) card.setAttribute('aria-label', `Open ${heading.textContent.trim()}`);
      card.addEventListener('click', (event) => {
        if (event.target.closest('a, button')) return;
        window.location.href = href;
      });
      card.addEventListener('keydown', (event) => {
        if (event.key === 'Enter' || event.key === ' ') {
          event.preventDefault();
          window.location.href = href;
        }
      });
    };

    document.querySelectorAll('.day-card').forEach((card) => makeClickable(card, routes.eventPlan));

    document.querySelectorAll('.track-card').forEach((card) => {
      const text = card.textContent.toLowerCase();
      if (text.includes('showcase')) makeClickable(card, routes.showcase);
      else if (text.includes('challenge')) makeClickable(card, routes.challenge);
      else if (text.includes('workshop')) makeClickable(card, routes.workshops);
    });

    document.querySelectorAll('.schedule-card').forEach((card) => {
      const text = card.textContent.toLowerCase();
      if (text.includes('gpu computing') || text.includes('genai & llms on hpc')) makeClickable(card, routes.workshops);
      else if (text.includes('hpc industry innovation showcase — session i') || text.includes('showcase session ii')) makeClickable(card, routes.showcase);
      else if (/challenge continues( non-stop)?\b/.test(text) && !text.includes('showcase')) makeClickable(card, routes.challenge);
    });

    document.querySelectorAll('.programme-card').forEach((card) => {
      const text = card.textContent.toLowerCase();
      if (text.includes('workshop')) makeClickable(card, routes.workshops);
      else if (text.includes('24-hour industry innovation challenge')) makeClickable(card, routes.challenge);
      else if (text.includes('innovation showcase')) makeClickable(card, routes.showcase);
    });
  </script>
</body>
</html>
<style>
@import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700;800&display=swap');
:global(*){box-sizing:border-box}
:global(html){scroll-behavior:smooth}
:global(body){margin:0;background:#f7f6f2;color:#161616;font-family:"DM Sans",Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;font-size:16px;line-height:1.6;padding-top:90px;padding-bottom:105px;opacity:0;transition:opacity .45s ease}
:global(body.is-ready){opacity:1}
:global(::selection){background:#2f708f;color:#fff}
:global(a),:global(button),.card-linkable{ -webkit-tap-highlight-color:transparent }
:global(a:focus-visible),:global(button:focus-visible),.card-linkable:focus-visible{outline:3px solid #2f708f;outline-offset:4px}
.skip-link{position:fixed;left:16px;top:12px;z-index:120;padding:9px 13px;border-radius:9px;background:#161616;color:#fff;text-decoration:none;font-size:13px;font-weight:800;transform:translateY(-160%);transition:transform .2s ease}
.skip-link:focus{transform:translateY(0)}
.site-header{position:fixed;top:18px;left:50%;transform:translateX(-50%);z-index:80;width:min(980px,calc(100% - 30px));padding:13px 16px;display:flex;justify-content:center;align-items:center;border:1px solid #d3d0c8;border-radius:16px;background:rgba(255,255,252,.94);backdrop-filter:blur(18px);box-shadow:0 14px 42px rgba(35,35,30,.12);transition:box-shadow .25s ease,background .25s ease}
.site-header:hover{box-shadow:0 18px 52px rgba(35,35,30,.16)}
.site-header nav{display:flex;justify-content:center;align-items:center;flex-wrap:wrap;gap:8px 22px}
.site-header nav a{position:relative;color:#55524d;text-decoration:none;font-size:14px;font-weight:700;letter-spacing:.025em;white-space:nowrap;padding:3px 0}
.site-header nav a::after{content:"";position:absolute;left:0;right:100%;bottom:-3px;height:2px;background:#2f708f;transition:right .2s ease}
.site-header nav a:hover,.site-header nav a[aria-current="page"]{color:#2f708f}
.site-header nav a:hover::after,.site-header nav a[aria-current="page"]::after{right:0}
.page-hero{position:relative;overflow:hidden;width:min(1180px,calc(100% - 44px));margin:auto;padding:120px 0 100px;border-bottom:1px solid #d7d5ce}
.page-hero>*:not(.hero-grid){position:relative;z-index:1}
.hero-grid{position:absolute;inset:35px -8% -10px;background-image:linear-gradient(rgba(49,112,143,.055) 1px,transparent 1px),linear-gradient(90deg,rgba(49,112,143,.055) 1px,transparent 1px);background-size:46px 46px;mask-image:linear-gradient(to bottom,transparent,black 18%,black 70%,transparent);opacity:.8;pointer-events:none}
.eyebrow,.content .label{margin:0;color:#31708f;font-size:13px;font-weight:800;letter-spacing:.16em;text-transform:uppercase}
.page-hero h1{max-width:950px;margin:20px 0 30px;font-size:clamp(64px,9vw,140px);line-height:.86;letter-spacing:-.075em;font-weight:800}
.page-hero h1 em{color:#2f708f;font-family:Georgia,serif;font-weight:400}
.intro{max-width:780px;margin:0;color:#66635d;font-size:clamp(20px,1.7vw,23px);line-height:1.7}
.content{width:min(1180px,calc(100% - 44px));margin:auto;padding:85px 0 140px}
.content h2{font-size:clamp(38px,5vw,70px);line-height:.95;letter-spacing:-.06em;margin:0 0 24px}
.content h2 em{color:#2f708f;font-family:Georgia,serif;font-weight:400}
.content p{color:#66635d;line-height:1.8;font-size:18px}
.grid{display:grid;grid-template-columns:repeat(2,1fr);gap:1px;background:#d7d5ce;border:1px solid #d7d5ce}
.card{background:#fbfaf7;padding:32px;transition:transform .25s ease,box-shadow .25s ease,background .25s ease}
.card:hover{transform:translateY(-3px);box-shadow:0 18px 38px rgba(35,35,30,.08);background:#fffefa}
.card small{display:block;color:#31708f;font-size:12px;font-weight:800;letter-spacing:.12em;text-transform:uppercase}
.card h3{margin:12px 0 10px;font-size:31px;letter-spacing:-.04em}
.card p{margin:0;font-size:17px}
.big-list{border-top:1px solid #d7d5ce}
.row{display:grid;grid-template-columns:70px 1fr auto;gap:22px;padding:30px 0;border-bottom:1px solid #d7d5ce;align-items:center;transition:padding .25s ease}
.row:hover{padding-left:8px}
.row .num{color:#8b8881;font-size:14px}
.row h3{margin:0 0 8px;font-size:32px;letter-spacing:-.04em}
.row p{margin:0;font-size:16px}
.fee{color:#2f708f;font-size:16px;font-weight:700}
.rules{margin-top:32px;padding:24px;border:1px solid #d7d5ce;background:#fbfaf7}
.rules strong{display:block;margin-bottom:11px;font-size:17px}
.rules span{display:block;color:#66635d;font-size:16px;line-height:1.75}
.card-linkable{cursor:pointer;transition:transform .25s ease,box-shadow .25s ease,border-color .25s ease}
.card-linkable:hover{transform:translateY(-5px);box-shadow:0 18px 42px rgba(35,35,30,.10);border-color:#bfcfd5}
.registration-bar{position:fixed;left:50%;bottom:18px;transform:translateX(-50%);z-index:90;width:min(760px,calc(100% - 30px));padding:12px 14px 12px 18px;display:flex;align-items:center;justify-content:space-between;gap:18px;border:1px solid #cfcac0;border-radius:18px;background:rgba(255,255,252,.96);backdrop-filter:blur(18px);box-shadow:0 18px 48px rgba(35,35,30,.16);transition:transform .25s ease,box-shadow .25s ease}
.registration-bar:hover{transform:translateX(-50%) translateY(-3px);box-shadow:0 22px 56px rgba(35,35,30,.20)}
.registration-bar>div{display:flex;align-items:baseline;gap:12px;min-width:0}
.registration-bar span:first-child{color:#77746e;font-size:10px;font-weight:800;letter-spacing:.12em;white-space:nowrap}
.registration-bar strong{font-size:14px;letter-spacing:-.01em}
.register-button{display:inline-flex;align-items:center;justify-content:center;gap:18px;flex:0 0 auto;padding:11px 17px;border-radius:11px;background:#161616;color:#fff;text-decoration:none;font-size:13px;font-weight:800;transition:transform .2s ease,background .2s ease}
.register-button:hover{background:#2f708f;transform:translateY(-1px)}
.register-button span{font-size:16px;transition:transform .2s ease}.register-button:hover span{transform:translate(2px,-2px)}
footer{width:min(1180px,calc(100% - 44px));margin:auto;border-top:1px solid #d7d5ce;padding:22px 0;color:#77746e;font-size:11px;font-weight:700;display:flex;justify-content:space-between;gap:20px}
@media(max-width:760px){
  :global(body){padding-top:76px;padding-bottom:95px}
  .site-header{top:10px;width:calc(100% - 20px);padding:11px 13px;justify-content:flex-start;overflow-x:auto;scrollbar-width:none}.site-header::-webkit-scrollbar{display:none}.site-header nav{justify-content:flex-start;flex-wrap:nowrap;gap:9px 17px;min-width:max-content}.site-header nav a{font-size:13px}
  .page-hero,.content,footer{width:min(100% - 30px,1180px)}.page-hero{padding:80px 0 70px}.page-hero h1{font-size:clamp(58px,16vw,100px)}.intro{font-size:18px}.hero-grid{background-size:32px 32px}
  .grid{grid-template-columns:1fr}.row{grid-template-columns:35px 1fr;gap:14px}.fee{grid-column:2}.content p{font-size:17px}.registration-bar{bottom:10px;width:calc(100% - 20px);padding:10px}.registration-bar>div{display:block}.registration-bar span:first-child{display:block;margin-bottom:2px}.registration-bar strong{font-size:13px}.register-button{padding:10px 13px}
}
@media(prefers-reduced-motion:reduce){:global(html){scroll-behavior:auto}:global(body),.site-header,.registration-bar,.register-button,.card,.card-linkable,.row,.site-header nav a::after{transition:none}.hero-grid{display:none}}
</style>
