---
import ConclavePage from '../layouts/ConclavePage.astro';
---

<ConclavePage title="About" eyebrow="About the Conclave" heading="Built around HPC." intro="A two-day HPC-focused conclave designed to connect industry leadership, practical computing, innovation and the KEC community.">
  <section class="about-intro">
    <div class="label">WHY THIS CONCLAVE</div>
    <div class="intro-grid">
      <h2>Connect.<br /><em>Compute. Create.</em></h2>
      <p>High-performance computing connects advanced computing infrastructure with real-world innovation. The conclave creates a common space for industry experts, students, faculty and innovators to learn, build and demonstrate solutions.</p>
    </div>
  </section>

  <section class="day-cards" aria-label="Two-day programme overview">
    <article class="day-card">
      <div class="card-top"><span>01</span><small>05 FEB · FRIDAY</small></div>
      <div class="card-body">
        <p class="phase">CONNECT &amp; EXPLORE</p>
        <h2>From opening ideas to competitive problem solving.</h2>
        <p>Inauguration, HPC keynote, industry leadership panel, GPU Computing &amp; CUDA and the launch of the 24-hour challenge.</p>
      </div>
      <div class="card-footer"><span>DAY 01</span><strong>→</strong></div>
    </article>

    <article class="day-card featured">
      <div class="card-top"><span>02</span><small>06 FEB · SATURDAY</small></div>
      <div class="card-body">
        <p class="phase">BUILD &amp; SHOWCASE</p>
        <h2>Learning, careers, innovation and evaluation.</h2>
        <p>GenAI &amp; LLMs on HPC, innovation showcase, careers and certifications, challenge evaluation and closing.</p>
      </div>
      <div class="card-footer"><span>DAY 02</span><strong>→</strong></div>
    </article>
  </section>

  <section class="focus-card">
    <div class="focus-mark">HPC</div>
    <div>
      <span class="label">THE FOCUS</span>
      <h2>Learn something practical. Build something meaningful. Show what works.</h2>
      <p>The programme moves from industry leadership and HPC-focused learning into hands-on computing, competitive problem solving and innovation showcase activities.</p>
    </div>
  </section>
</ConclavePage>

<style>
  .about-intro{margin-bottom:76px}.intro-grid{display:grid;grid-template-columns:1.05fr .95fr;gap:80px;align-items:end;margin-top:24px}.intro-grid h2{margin:0;font-size:clamp(48px,6vw,86px);line-height:.91;letter-spacing:-.065em}.intro-grid p{margin:0;max-width:620px;font-size:20px;line-height:1.75;color:#66635d}
  .day-cards{display:grid;grid-template-columns:repeat(2,1fr);gap:24px;margin-top:20px}.day-card{min-height:475px;padding:31px;border:1px solid #d7d5ce;border-radius:29px;background:#fbfaf7;box-shadow:0 22px 52px rgba(35,35,30,.10);display:flex;flex-direction:column;justify-content:space-between;transition:transform .25s ease,box-shadow .25s ease}.day-card:hover{transform:translateY(-9px);box-shadow:0 32px 70px rgba(35,35,30,.15)}.day-card.featured{background:#eef5f7;border-color:#cbdde3;transform:translateY(-14px)}.day-card.featured:hover{transform:translateY(-23px)}
  .card-top{display:flex;justify-content:space-between;align-items:flex-start}.card-top span{font-size:13px;font-weight:800;color:#aaa69e}.card-top small{color:#31708f;font-size:12px;font-weight:800;letter-spacing:.1em}.card-body{padding:55px 0 45px}.phase{margin:0 0 17px!important;color:#31708f!important;font-size:12px!important;font-weight:800;letter-spacing:.14em;text-transform:uppercase}.card-body h2{margin:0 0 20px;font-size:clamp(31px,3.2vw,46px);line-height:1;letter-spacing:-.055em}.card-body>p:last-child{margin:0;max-width:500px;font-size:16px;line-height:1.7;color:#66635d}.card-footer{padding-top:19px;border-top:1px solid #d7d5ce;display:flex;justify-content:space-between;align-items:center}.card-footer span{font-size:11px;font-weight:800;letter-spacing:.12em;color:#8b8881}.card-footer strong{font-size:22px;color:#31708f}
  .focus-card{margin-top:76px;padding:44px 48px;border-radius:27px;background:#161616;color:#f7f6f2;box-shadow:0 24px 60px rgba(0,0,0,.13);display:grid;grid-template-columns:120px 1fr;gap:35px;align-items:start}.focus-mark{font-size:28px;font-weight:800;letter-spacing:-.05em;color:#a8c7d3}.focus-card .label{color:#a8c7d3}.focus-card h2{margin:14px 0 13px;color:#f7f6f2;font-size:clamp(34px,4.5vw,58px);line-height:.98;letter-spacing:-.055em}.focus-card p{max-width:760px;margin:0;color:#c7c5bf;font-size:16px;line-height:1.65}
  @media(max-width:760px){.about-intro{margin-bottom:55px}.intro-grid{display:block}.intro-grid p{margin-top:24px;font-size:18px}.day-cards{grid-template-columns:1fr;gap:17px}.day-card,.day-card.featured{min-height:390px;padding:25px;transform:none}.day-card:hover,.day-card.featured:hover{transform:translateY(-7px)}.card-body{padding:45px 0 35px}.focus-card{margin-top:50px;padding:30px;grid-template-columns:1fr;gap:18px}.focus-mark{font-size:24px}}
</style>
