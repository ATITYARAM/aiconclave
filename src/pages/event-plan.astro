---
import ConclavePage from '../layouts/ConclavePage.astro';
const days=[['DAY 1 · 05 FEB · FRIDAY',['9:00 – 9:30 AM · Registration & Networking','9:30 – 10:15 AM · Inauguration','10:15 – 11:15 AM · HPC Keynote','11:15 – 11:30 AM · Tea Break','11:30 AM – 1:00 PM · Industry Leadership Panel','1:00 – 2:00 PM · Lunch — 24-hour Innovation Challenge participants only','2:00 – 2:15 PM · Workshop / Challenge Briefing','2:15 – 4:15 PM · GPU Computing & CUDA / Challenge Development','4:15 – 4:30 PM · Challenge Continues','4:30 PM onwards · Challenge Continues Non-Stop']],['DAY 2 · 06 FEB · SATURDAY',['9:00 – 10:15 AM · GenAI & LLMs on HPC / Showcase Preparation / Challenge Continues','10:30 AM – 12:30 PM · HPC Industry Innovation Showcase — Session I','12:30 – 1:30 PM · Lunch — 24-hour Innovation Challenge participants only · Showcase Continues · Challenge Continues','1:30 – 2:30 PM · HPC Careers & Certifications / Showcase Session II / Challenge Continues','2:30 – 3:15 PM · Break · Jury Interaction · Challenge Continues','Before 3:15 PM · Final Showcase Interaction & Challenge Submission / Evaluation','3:15 – 4:15 PM · Valedictory & Closing']]];
---
<ConclavePage title="Event Plan" eyebrow="Event Plan" heading="Two days. One focused programme." intro="Friday, 5 February and Saturday, 6 February 2027. Explore the complete flow from opening sessions through workshops, challenge and showcase.">
  {days.map(([day,items])=><div style="margin-bottom:70px"><div class="label">{day}</div><div class="big-list">{items.map((item,i)=><div class="row"><span class="num">{String(i+1).padStart(2,'0')}</span><div><h3>{item.split(' · ')[1]}</h3><p>{item.split(' · ')[0]}</p></div></div>)}</div></div>)}
</ConclavePage>
