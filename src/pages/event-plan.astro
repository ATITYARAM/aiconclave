---
import ConclavePage from '../layouts/ConclavePage.astro';

const days = [
  {
    label: 'DAY 1',
    date: '05 FEB · FRIDAY',
    theme: 'CONNECT & EXPLORE',
    items: [
      ['9:00 – 9:30 AM', 'Registration & Networking'],
      ['9:30 – 10:15 AM', 'Inauguration'],
      ['10:15 – 11:15 AM', 'HPC Keynote'],
      ['11:15 – 11:30 AM', 'Tea Break'],
      ['11:30 AM – 1:00 PM', 'Industry Leadership Panel'],
      ['1:00 – 2:00 PM', 'Lunch', '24-hour Innovation Challenge participants only'],
      ['2:00 – 2:15 PM', 'GPU Computing & CUDA / Challenge Briefing'],
      ['2:15 – 4:15 PM', 'GPU Computing & CUDA / Challenge Development'],
      ['4:15 – 4:30 PM', 'Challenge Continues'],
      ['4:30 PM onwards', 'Challenge Continues Non-Stop']
    ]
  },
  {
    label: 'DAY 2',
    date: '06 FEB · SATURDAY',
    theme: 'BUILD & SHOWCASE',
    items: [
      ['9:00 – 10:15 AM', 'GenAI & LLMs on HPC / Showcase Setup / Preparation / Challenge Continues'],
      ['10:15 – 10:30 AM', 'Challenge Continues'],
      ['10:30 AM – 12:30 PM', 'HPC Industry Innovation Showcase — Session I'],
      ['12:30 – 1:30 PM', 'Lunch · Showcase Continues · Challenge Continues', 'Lunch is for 24-hour Innovation Challenge participants only'],
      ['1:30 – 2:30 PM', 'HPC Careers & Certifications / Showcase Session II / Challenge Continues'],
      ['2:30 – 3:15 PM', 'Break · Showcase / Jury Interaction · Challenge Continues'],
      ['Before 3:15 PM', 'Final Showcase Interaction & Recognition / Challenge Final Submission & Evaluation'],
      ['3:15 – 4:15 PM', 'Valedictory & Closing']
    ]
  }
];
---

<ConclavePage
  title="Event Plan"
  eyebrow="05–06 February 2027 · KEC"
  heading="Two days. One focused programme."
  intro="A complete view of the Conclave schedule — from the opening programme to workshops, the 24-hour challenge and the innovation showcase."
>
  <div class="day-switcher" aria-label="Event days">
    <span>DAY 1 · CONNECT &amp; EXPLORE</span>
    <span>DAY 2 · BUILD &amp; SHOWCASE</span>
  </div>

  {days.map((day, dayIndex) => (
    <section class={`day ${dayIndex === 1 ? 'second-day' : ''}`}>
      <header class="day-header">
        <div>
          <span class="day-number">{day.label}</span>
          <h2>{day.date}</h2>
        </div>
        <strong>{day.theme}</strong>
      </header>

      <div class="schedule">
        {day.items.map((item, i) => (
          <article class={`schedule-card ${i === 0 || i === day.items.length - 1 ? 'edge-card' : ''}`}>
            <div class="time">{item[0]}</div>
            <div class="schedule-main">
              <span class="index">{String(i + 1).padStart(2, '0')}</span>
              <div>
                <h3>{item[1]}</h3>
                {item[2] && <p>{item[2]}</p>}
              </div>
            </div>
          </article>
        ))}
      </div>
    </section>
  ))}

  <section class="parallel-note">
    <span class="label">How to read Day 2</span>
    <h2>Three activities run in parallel.</h2>
    <p>On Day 2, the Conclave / Workshop programme, KEC Innovation Showcase and HPC Industry Innovation Challenge remain distinct throughout the day.</p>
  </section>
</ConclavePage>

<style>
  .day-switcher{display:flex;gap:12px;flex-wrap:wrap;margin-bottom:75px}
  .day-switcher span{padding:12px 17px;border:1px solid #d7d5ce;border-radius:999px;background:#fbfaf7;color:#55524d;font-size:12px;font-weight:800;letter-spacing:.08em}
  .day{margin-bottom:105px}
  .day-header{display:flex;justify-content:space-between;align-items:flex-end;gap:30px;margin-bottom:35px;padding-bottom:22px;border-bottom:1px solid #d7d5ce}
  .day-number{display:block;color:#31708f;font-size:12px;font-weight:800;letter-spacing:.15em}
  .day-header h2{margin:10px 0 0;font-size:clamp(38px,5vw,68px);line-height:.95;letter-spacing:-.06em}
  .day-header strong{padding-bottom:7px;color:#8b8881;font-size:12px;letter-spacing:.13em;text-transform:uppercase;white-space:nowrap}
  .schedule{display:grid;grid-template-columns:repeat(2,1fr);gap:16px}
  .schedule-card{min-height:155px;padding:26px;background:#fbfaf7;border:1px solid #d7d5ce;border-radius:20px;box-shadow:0 12px 34px rgba(35,35,30,.06);display:flex;flex-direction:column;justify-content:space-between;gap:22px}
  .schedule-card.edge-card{background:#eef5f7;border-color:#cbdde3}
  .time{color:#31708f;font-size:12px;font-weight:800;letter-spacing:.08em;text-transform:uppercase}
  .schedule-main{display:grid;grid-template-columns:38px 1fr;gap:15px;align-items:start}
  .index{color:#aaa69e;font-size:12px;font-weight:700;padding-top:4px}
  .schedule-main h3{margin:0;font-size:24px;line-height:1.12;letter-spacing:-.035em}
  .schedule-main p{margin:9px 0 0;font-size:14px;line-height:1.55;color:#66635d}
  .parallel-note{padding:42px;background:#161616;color:#f7f6f2;border-radius:24px;margin-top:-25px}
  .parallel-note .label{color:#a8c7d3}
  .parallel-note h2{margin:16px 0 12px;color:#f7f6f2;font-size:clamp(34px,5vw,62px);line-height:.95}
  .parallel-note p{max-width:760px;margin:0;color:#c7c5bf}
  @media(max-width:760px){.day-switcher{margin-bottom:55px}.day-header{display:block}.day-header strong{display:block;margin-top:18px}.schedule{grid-template-columns:1fr}.schedule-card{min-height:135px}.parallel-note{padding:30px;margin-top:-20px}}
</style>
