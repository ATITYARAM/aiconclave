---
import ConclavePage from '../layouts/ConclavePage.astro';

const days = [
  {
    label: 'DAY 1', date: '05 FEB · FRIDAY', theme: 'CONNECT & EXPLORE',
    items: [
      ['9:00 – 9:30 AM', 'Registration & Networking'],
      ['9:30 – 10:15 AM', 'Inauguration'],
      ['10:15 – 11:15 AM', 'HPC Keynote'],
      ['11:15 – 11:30 AM', 'Tea Break'],
      ['11:30 AM – 1:00 PM', 'Industry Leadership Panel'],
      ['1:00 – 2:00 PM', 'Lunch', '24-hour Innovation Challenge participants only'],
      ['2:00 – 2:15 PM', 'GPU Computing & CUDA / Challenge Briefing'],
      ['2:15 – 4:15 PM', 'GPU Computing & CUDA / Challenge Development'],
      ['4:15 – 4:30 PM', 'Challenge Continues'],
      ['4:30 PM onwards', 'Challenge Continues Non-Stop']
    ]
  },
  {
    label: 'DAY 2', date: '06 FEB · SATURDAY', theme: 'BUILD & SHOWCASE',
    items: [
      ['9:00 – 10:15 AM', 'GenAI & LLMs on HPC / Showcase Setup / Preparation / Challenge Continues'],
      ['10:15 – 10:30 AM', 'Challenge Continues'],
      ['10:30 AM – 12:30 PM', 'HPC Industry Innovation Showcase — Session I'],
      ['12:30 – 1:30 PM', 'Lunch · Showcase Continues · Challenge Continues', 'Lunch is for 24-hour Innovation Challenge participants only'],
      ['1:30 – 2:30 PM', 'HPC Careers & Certifications / Showcase Session II / Challenge Continues'],
      ['2:30 – 3:15 PM', 'Break · Showcase / Jury Interaction · Challenge Continues'],
      ['Before 3:15 PM', 'Final Showcase Interaction & Recognition / Challenge Final Submission & Evaluation'],
      ['3:15 – 4:15 PM', 'Valedictory & Closing']
    ]
  }
];
---

<ConclavePage title="Event Plan" eyebrow="05–06 February 2027 · KEC" heading="Two days. One focused programme." intro="A complete view of the Conclave schedule — from the opening programme to workshops, the 24-hour challenge and the innovation showcase.">
  <div class="day-intro">
    <span class="label">The programme</span>
    <p>Each day is presented as a set of floating schedule cards, making the timing and programme easy to scan.</p>
  </div>

  {days.map((day, dayIndex) => (
    <section class="day">
      <header class="day-header">
        <div><span class="day-number">{day.label}</span><h2>{day.date}</h2></div>
        <strong>{day.theme}</strong>
      </header>
      <div class="schedule">
        {day.items.map((item, i) => (
          <article class={`schedule-card ${i % 3 === 1 ? 'lifted' : ''} ${i === 0 || i === day.items.length - 1 ? 'highlight' : ''}`}>
            <div class="card-top"><span class="index">{String(i + 1).padStart(2, '0')}</span><span class="time">{item[0]}</span></div>
            <div><h3>{item[1]}</h3>{item[2] && <p>{item[2]}</p>}</div>
          </article>
        ))}
      </div>
    </section>
  ))}

  <section class="parallel-note">
    <span class="label">Day 2</span>
    <h2>Three activities run in parallel.</h2>
    <p>The Conclave / Workshop programme, KEC Innovation Showcase and HPC Industry Innovation Challenge remain distinct throughout Day 2.</p>
  </section>
</ConclavePage>

<style>
  .day-intro{display:flex;justify-content:space-between;gap:40px;align-items:flex-end;margin-bottom:72px;padding-bottom:28px;border-bottom:1px solid #d7d5ce}.day-intro p{max-width:560px;margin:0;font-size:17px}
  .day{margin-bottom:110px}.day-header{display:flex;justify-content:space-between;align-items:flex-end;gap:30px;margin-bottom:40px}.day-number{display:block;color:#31708f;font-size:12px;font-weight:800;letter-spacing:.15em}.day-header h2{margin:10px 0 0;font-size:clamp(40px,5vw,70px);line-height:.95;letter-spacing:-.06em}.day-header strong{color:#8b8881;font-size:12px;letter-spacing:.13em;text-transform:uppercase;padding-bottom:7px}
  .schedule{display:grid;grid-template-columns:repeat(2,1fr);gap:22px}.schedule-card{min-height:185px;padding:28px;border:1px solid #d7d5ce;border-radius:24px;background:#fbfaf7;box-shadow:0 18px 45px rgba(35,35,30,.09);display:flex;flex-direction:column;justify-content:space-between;transition:transform .25s ease,box-shadow .25s ease}.schedule-card:hover{transform:translateY(-7px);box-shadow:0 28px 58px rgba(35,35,30,.14)}.schedule-card.lifted{transform:translateY(-8px)}.schedule-card.lifted:hover{transform:translateY(-14px)}.schedule-card.highlight{background:#eef5f7;border-color:#cbdde3}.card-top{display:flex;justify-content:space-between;align-items:flex-start;gap:18px}.index{color:#aaa69e;font-size:12px;font-weight:800}.time{color:#31708f;font-size:12px;font-weight:800;letter-spacing:.07em;text-transform:uppercase;text-align:right}.schedule-card h3{margin:35px 0 0;font-size:27px;line-height:1.1;letter-spacing:-.04em}.schedule-card p{margin:10px 0 0;font-size:14px;line-height:1.55;color:#66635d}
  .parallel-note{margin-top:-20px;padding:45px;border-radius:26px;background:#161616;color:#f7f6f2;box-shadow:0 22px 55px rgba(0,0,0,.12)}.parallel-note .label{color:#a8c7d3}.parallel-note h2{margin:15px 0 12px;color:#f7f6f2;font-size:clamp(38px,5vw,65px);line-height:.95;letter-spacing:-.055em}.parallel-note p{max-width:760px;margin:0;color:#c7c5bf}
  @media(max-width:760px){.day-intro{display:block;margin-bottom:55px}.day-intro p{margin-top:14px}.day-header{display:block}.day-header strong{display:block;margin-top:17px}.schedule{grid-template-columns:1fr;gap:16px}.schedule-card{min-height:155px}.schedule-card.lifted{transform:none}.schedule-card.lifted:hover{transform:translateY(-6px)}.parallel-note{padding:30px;margin-top:-10px}}
</style>
