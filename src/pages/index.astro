r-spacing:.15em}.closing h2{margin:23px 0;font-size:clamp(53px,8vw,110px);line-height:.9;letter-spacing:-.065em}.registration-bar{position:fixed;z-index:50;left:50%;bottom:18px;transform:translateX(-50%);width:min(920px,calc(100% - 30px));padding:14px 14px 14px 21px;display:flex;align-items:center;justify-content:space-between;gap:20px;border:1px solid #d3d0c8;border-radius:15px;background:rgba(255,255,252,.95);backdrop-filter:blur(18px);box-shadow:0 18px 55px rgba(35,35,30,.14)}.registration-bar>div{display:flex;flex-direction:column;gap:5px}.registration-bar span{color:#31708f;font-size:11px;font-weight:850;letter-spacing:.14em}.registration-bar strong{font-size:15px}.register-button{display:inline-flex;align-items:center;justify-content:center;border:0;border-radius:9px;background:#2f708f;color:#fff;text-decoration:none;padding:15px 21px;font-weight:800;font-size:15px;cursor:pointer}.register-button:hover{background:#255e79}.register-button span{margin-left:14px;color:#fff;font-size:15px}.rules-modal{position:fixed;inset:0;z-index:100;display:none}.rules-modal[aria-hidden="false"]{display:block}.rules-backdrop{position:absolute;inset:0;background:rgba(22,22,22,.45);backdrop-filter:blur(9px)}.rules-panel{position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);width:min(740px,calc(100% - 28px));max-height:calc(100vh - 30px);overflow:auto;padding:34px;border:1px solid #d4d1c9;border-radius:18px;background:#fbfaf7;box-shadow:0 30px 100px rgba(30,30,25,.24)}.rules-close{position:absolute;right:16px;top:12px;border:0;background:none;font-size:28px;color:#77746e;cursor:pointer}.rules-panel h2{margin:13px 0;font-size:clamp(44px,7vw,72px);line-height:.88;letter-spacing:-.065em}.rules-intro{max-width:590px;color:#66635d;font-size:15px;line-height:1.65}.rule-list{margin-top:24px;border-top:1px solid #ddd9d1}.rule-list div{display:grid;grid-template-columns:38px 1fr;gap:12px;padding:14px 0;border-bottom:1px solid #ddd9d1}.rule-list b{color:#2f708f;font-size:12px}.rule-list span{color:#55524d;font-size:13px;line-height:1.55}.countdown-wrap{display:flex;align-items:center;gap:13px;margin-top:23px;padding:16px;background:#f2f7f9;border:1px solid #d7e2e7}.countdown-wrap span{font-size:29px;font-weight:850;color:#2f708f;min-width:34px}.countdown-wrap small{color:#66635d;font-size:12px}.rules-continue{width:100%;margin-top:12px;border:0;border-radius:9px;padding:16px;background:#2f708f;color:#fff;font-weight:850;font-size:15px;cursor:pointer}.rules-continue:disabled{background:#c9c8c2;color:#88867f;cursor:not-allowed}.rules-continue span{margin-left:15px}.wait-note{margin:10px 0 0;text-align:center;color:#8b8881;font-size:11px}.rules-modal.ready .countdown-wrap{background:#eef6f1;border-color:#c8ded1}.rules-modal.ready .wait-note{color:#2f708f}@media(max-width:850px){.site-header{align-items:flex-start;flex-direction:column}.site-header nav{justify-content:flex-start;gap:9px 16px}.site-header nav a{font-size:12px}.hero-inner,.about,.tracks,.plan{width:min(100% - 30px,1180px)}.identity-strip{justify-content:flex-start}.identity-mark{padding-left:0;padding-right:15px;margin-right:15px}.identity-mark strong{font-size:17px}.identity-mark span{font-size:10px}.signals{grid-template-columns:1fr 1fr;gap:20px 0}.signals div:nth-child(3){border-left:0;padding-left:0}.about-grid{grid-template-columns:1fr;gap:30px}.about-grid div{border-left:0;border-top:1px solid #d7d5ce;padding:22px 0 0}.track-row{grid-template-columns:35px 1fr}.track-row strong{grid-column:2}.registration-bar{bottom:10px;width:calc(100% - 20px);padding-left:15px}.registration-bar span{font-size:9px}.registration-bar strong{font-size:13px}.register-button{padding:13px 16px;font-size:14px}.rules-panel{padding:27px 20px}.rule-list span{font-size:12px}}
</style>
<script>
const modal=document.querySelector('#rules-modal');const open=document.querySelector('#register-open');const closeButtons=modal?.querySelectorAll('[data-rules-close]');const continueButton=document.querySelector('#rules-continue');const countdown=document.querySelector('#countdown');let timer;
const closeModal=()=>{modal?.setAttribute('aria-hidden','true');if(timer)window.clearInterval(timer)};
open?.addEventListener('click',()=>{modal?.setAttribute('aria-hidden','false');modal?.classList.remove('ready');continueButton.disabled=true;countdown.textContent='30';let seconds=30;if(timer)window.clearInterval(timer);timer=window.setInterval(()=>{seconds-=1;countdown.textContent=String(seconds);if(seconds<=0){window.clearInterval(timer);modal?.classList.add('ready');continueButton.disabled=false;document.querySelector('#wait-note').textContent='You can now continue to registration and payment.'}},1000)});
closeButtons?.forEach((button)=>button.addEventListener('click',closeModal));document.addEventListener('keydown',(event)=>{if(event.key==='Escape')closeModal()});continueButton?.addEventListener('click',()=>{window.location.href='/aiconclave/registration-details/'});
</script>
