---
const events = [
  { id: 'inauguration', number: '01', title: 'Inauguration', label: 'Keynote Address & Panel Discussion', date: '05 Feb 2027 · Friday', time: '9:30 AM – 11:00 AM', venue: 'Maharaja Auditorium' },
  { id: 'pitch', number: '02', title: 'Pitch Your Idea', label: 'Early stage startups & Students – TRL 4 above', date: '05 Feb 2027 · Friday', time: '11:00 AM – 1:30 PM', venue: 'TBI – Conference Hall' },
  { id: 'golang', number: '03', title: 'Workshop 1', label: 'GoLang Framework', date: '05 Feb 2027 · Friday', time: '1:30 PM – 4:30 PM', venue: 'Maharaja Auditorium' },
  { id: 'hackathon', number: '04', title: '24 hrs Hackathon', label: 'For given problem statements', date: '05 – 06 Feb 2027', time: '1:00 PM – 1:00 PM', venue: 'CC 1, 2 & CC 11, 12' },
  { id: 'genai', number: '05', title: 'Workshop 2', label: 'GenAI in Action', date: '06 Feb 2027 · Saturday', time: '9:30 AM – 12:30 PM', venue: 'Maharaja Auditorium' },
  { id: 'expo', number: '06', title: 'Projects Expo', label: 'Top 12 teams', date: '06 Feb 2027 · Saturday', time: '9:30 AM – 12:30 PM', venue: 'CC 3, 4' },
  { id: 'valedictory', number: '07', title: 'Valedictory', label: 'Guest Address & Prize Distribution', date: '06 Feb 2027 · Saturday', time: '3:30 PM – 4:30 PM', venue: 'Maharaja Auditorium' }
];
const registrationEvents = events.filter((event) => !['inauguration', 'valedictory'].includes(event.id));
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>AI Conclave 1.0 · Shape Next Reality</title>
  <meta name="description" content="AI Conclave 1.0 at Kongu Engineering College. 5–6 February 2027." />
</head>
<body>
<main>
<section class="hero"><div class="hero-inner">
  <div class="topline"><span>AI CONCLAVE 1.0</span><span>05–06 FEB 2027 · KEC</span></div>
  <div class="hero-copy"><p class="kicker">KONGU ENGINEERING COLLEGE</p><h1>Shape<br /><em>Next Reality.</em></h1><p class="intro">A two-day AI event organised by the Department of AI in association with the Innovation &amp; Entrepreneurship Forum (IEF), bringing together keynote discussions, workshops, a 24 hour hackathon, startup pitches and a projects expo.</p></div>
  <div class="signals"><div><strong>07</strong><span>Event sessions</span></div><div><strong>24H</strong><span>Hackathon</span></div><div><strong>02</strong><span>Workshops</span></div><div><strong>12</strong><span>Expo teams</span></div></div>
</div></section>
<section class="about"><div class="section-label">AI CONCLAVE 1.0</div><div class="about-grid"><h2>Two days.<br /><em>One AI conclave.</em></h2><div><p>AI Conclave 1.0 takes place on Friday, 5 February and Saturday, 6 February 2027 at Maharaja Auditorium, KEC.</p><p>Organised by the Department of AI in association with Innovation &amp; Entrepreneurship Forum (IEF), Kongu Engineering College.</p></div></div></section>
<section class="program"><div class="section-head"><div class="section-label">EVENT PLAN</div><p>05 &amp; 06 FEB 2027 · FRIDAY &amp; SATURDAY</p></div><div class="program-list">
{events.map((event) => <article class="program-row"><span class="number">{event.number}</span><div class="event-main"><small>{event.label}</small><h2>{event.title}</h2><p>{event.venue}</p></div><div class="program-meta"><strong>{event.date}</strong><span>{event.time}</span></div></article>)}
</div></section>
<section class="closing"><p>MAHARAJA AUDITORIUM · KONGU ENGINEERING COLLEGE</p><h2>Shape the<br /><em>next reality.</em></h2><p class="organiser">Organised by Dept. of AI in association with Innovation &amp; Entrepreneurship Forum (IEF).</p></section>
</main>
<div class="registration-bar"><div class="bar-copy"><span>AI CONCLAVE 1.0</span><strong>Registration</strong></div><button id="open-registration" class="register-button">Register <span>↗</span></button></div>
<div id="registration-modal" class="modal" aria-hidden="true"><div class="modal-backdrop" data-close></div><section class="modal-panel" role="dialog" aria-modal="true" aria-labelledby="registration-title"><button class="close" type="button" aria-label="Close registration" data-close>×</button><div class="modal-header"><p class="kicker">REGISTRATION</p><h2 id="registration-title">Register for AI Conclave 1.0.</h2><p>Enter your details and select the event sessions you want to attend.</p></div><form id="registration-form"><div class="fields"><label>Full name *<input name="name" required autocomplete="name" placeholder="Full name" /></label><label>Email *<input name="email" type="email" required autocomplete="email" placeholder="Email address" /></label><label>Mobile *<input name="phone" type="tel" required autocomplete="tel" placeholder="Mobile number" /></label><label>Institution / Organisation *<input name="institution" required placeholder="Institution or organisation" /></label><label>Participant type *<select name="role" required><option value="">Select participant type</option><option>Student</option><option>Faculty / Researcher</option><option>Startup / Founder</option><option>Industry Professional</option><option>Other</option></select></label><label>City<input name="city" placeholder="City" /></label></div><div class="choose"><p class="kicker">EVENTS</p><h3>Select your participation</h3><div class="track-grid">{registrationEvents.map((event) => <label class="track-option"><input type="checkbox" name="events" value={event.id} /><span class="box"></span><span><b>{event.title}</b><small>{event.label}</small></span></label>)}</div></div><label class="consent"><input type="checkbox" required /> <span>I confirm that the information provided is accurate.</span></label><button class="continue" type="submit">Continue <span>→</span></button><p id="status" class="status" aria-live="polite"></p></form></section></div>
<script>
const modal=document.querySelector('#registration-modal'),openButton=document.querySelector('#open-registration'),form=document.querySelector('#registration-form'),status=document.querySelector('#status');
const closeModal=()=>{modal?.setAttribute('aria-hidden','true');document.body.classList.remove('locked')};
openButton?.addEventListener('click',()=>{modal?.setAttribute('aria-hidden','false');document.body.classList.add('locked');setTimeout(()=>modal?.querySelector('input')?.focus(),50)});
modal?.querySelectorAll('[data-close]').forEach(el=>el.addEventListener('click',closeModal));document.addEventListener('keydown',e=>{if(e.key==='Escape')closeModal()});
form?.addEventListener('submit',e=>{e.preventDefault();status.textContent='Registration form ready for the payment gateway connection.'});
</script>
</body></html>
<style>
:global(*){box-sizing:border-box}:global(html){scroll-behavior:smooth}:global(body){margin:0;background:#f7f6f2;color:#161616;font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif}:global(body.locked){overflow:hidden}:global(button),:global(input),:global(select){font:inherit}
.hero{min-height:86vh;border-bottom:1px solid #d8d6cf;background:radial-gradient(circle at 75% 18%,rgba(169,52,52,.10),transparent 30%),linear-gradient(145deg,#fbfaf7,#f1f0eb 65%,#faf9f5)}.hero-inner{width:min(1180px,calc(100% - 44px));min-height:86vh;margin:auto;padding:30px 0 54px;display:flex;flex-direction:column}.topline{display:flex;justify-content:space-between;border-bottom:1px solid #d7d5ce;padding-bottom:17px;color:#77746e;font-size:10px;font-weight:800;letter-spacing:.2em}.hero-copy{margin:auto 0;padding:70px 0 80px}.kicker,.section-label{margin:0;color:#9f4141;font-size:10px;font-weight:850;letter-spacing:.2em}h1{margin:16px 0 24px;font-size:clamp(64px,11vw,150px);line-height:.82;letter-spacing:-.075em;font-weight:780}h1 em,h2 em{color:#a54242;font-family:Georgia,serif;font-weight:400}.intro{max-width:650px;margin:0;color:#66635d;font-size:clamp(15px,1.6vw,19px);line-height:1.65}.signals{display:grid;grid-template-columns:repeat(4,1fr);border-top:1px solid #d7d5ce;padding-top:18px}.signals div{display:flex;flex-direction:column;gap:4px;border-left:1px solid #d7d5ce;padding-left:18px}.signals div:first-child{border-left:0;padding-left:0}.signals strong{font-size:22px;letter-spacing:-.03em}.signals span{color:#77746e;font-size:10px;text-transform:uppercase;letter-spacing:.12em}
.about,.program{width:min(1180px,calc(100% - 44px));margin:auto}.about{padding:105px 0 110px}.about-grid{display:grid;grid-template-columns:1.15fr .85fr;gap:80px;align-items:end;margin-top:28px}.about h2{margin:0;font-size:clamp(42px,6vw,78px);line-height:.94;letter-spacing:-.065em}.about-grid div{border-left:1px solid #d7d5ce;padding-left:25px}.about-grid p{margin:0 0 14px;color:#66635d;font-size:14px;line-height:1.7}.about-grid p:last-child{margin-bottom:0}.program{padding:0 0 120px}.section-head{display:flex;justify-content:space-between;align-items:end;border-bottom:1px solid #d0cec7;padding-bottom:17px}.section-head p{margin:0;color:#77746e;font-size:10px;letter-spacing:.15em}.program-row{display:grid;grid-template-columns:70px 1fr auto;gap:20px;align-items:center;padding:28px 0;border-bottom:1px solid #d8d6cf}.number{color:#8b8881;font-size:11px}.event-main small{color:#77746e;font-size:10px;text-transform:uppercase;letter-spacing:.12em}.event-main h2{margin:7px 0 5px;font-size:clamp(23px,3vw,38px);letter-spacing:-.045em}.event-main p{margin:0;color:#8a8780;font-size:11px}.program-meta{display:flex;flex-direction:column;align-items:flex-end;gap:5px;color:#77746e;font-size:11px;text-align:right}.program-meta strong{color:#33312e;font-weight:700}.closing{min-height:58vh;display:flex;flex-direction:column;justify-content:center;align-items:center;text-align:center;border-top:1px solid #d8d6cf;padding:80px 22px 170px}.closing>p:first-child{color:#77746e;font-size:10px;letter-spacing:.18em}.closing h2{margin:20px 0 0;font-size:clamp(48px,8vw,100px);line-height:.9;letter-spacing:-.065em}.closing .organiser{max-width:650px;margin:28px 0 0;color:#77746e;font-size:11px;line-height:1.6}
.registration-bar{position:fixed;z-index:20;left:50%;bottom:18px;transform:translateX(-50%);width:min(1050px,calc(100% - 28px));padding:12px 13px 12px 20px;display:flex;align-items:center;justify-content:space-between;gap:20px;border:1px solid #d2d0c9;border-radius:15px;background:rgba(255,255,252,.93);backdrop-filter:blur(18px);box-shadow:0 18px 60px rgba(40,36,28,.13)}.bar-copy{display:flex;flex-direction:column;gap:3px}.bar-copy span{color:#9f4141;font-size:9px;font-weight:850;letter-spacing:.18em}.bar-copy strong{font-size:13px}.register-button,.continue{border:0;border-radius:9px;background:#a54242;color:#fff;padding:14px 19px;font-weight:800;cursor:pointer}.register-button:hover,.continue:hover{background:#8f3838}.register-button span,.continue span{margin-left:14px}
.modal{position:fixed;z-index:40;inset:0;display:none}.modal[aria-hidden="false"]{display:block}.modal-backdrop{position:absolute;inset:0;background:rgba(28,26,23,.42);backdrop-filter:blur(9px)}.modal-panel{position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);width:min(760px,calc(100% - 28px));max-height:calc(100vh - 34px);overflow:auto;border:1px solid #d5d3cc;border-radius:18px;background:#fbfaf7;box-shadow:0 30px 100px rgba(40,36,28,.25);padding:32px}.close{position:absolute;top:16px;right:17px;border:0;background:transparent;color:#77746e;font-size:28px;cursor:pointer}.modal-header{padding-right:35px;padding-bottom:25px;border-bottom:1px solid #ddd9d1}.modal-header h2{margin:10px 0 8px;font-size:clamp(34px,5vw,52px);letter-spacing:-.06em}.modal-header p:last-child{max-width:560px;margin:0;color:#6f6c65;font-size:13px;line-height:1.6}form{padding-top:25px}.fields{display:grid;grid-template-columns:1fr 1fr;gap:15px}label{color:#55524d;font-size:11px;font-weight:700}input,select{display:block;width:100%;margin-top:7px;border:1px solid #d5d2ca;border-radius:9px;outline:none;background:#fffefa;color:#20201e;padding:12px 13px}input::placeholder{color:#a19e97}input:focus,select:focus{border-color:#a54242}.choose{margin-top:27px;padding-top:25px;border-top:1px solid #ddd9d1}.choose h3{margin:7px 0 15px;font-size:17px}.track-grid{display:grid;grid-template-columns:1fr 1fr;gap:9px}.track-option{display:flex;align-items:flex-start;gap:10px;padding:12px;border:1px solid #d7d4cc;border-radius:9px;cursor:pointer;background:#fffefa}.track-option:has(input:checked){border-color:#a54242;background:#fbf2f2}.track-option input{display:none}.box{width:16px;height:16px;flex:0 0 16px;border:1px solid #aaa69e;border-radius:4px;margin-top:1px}.track-option:has(input:checked) .box{background:#a54242;box-shadow:inset 0 0 0 3px #fbf2f2;border-color:#a54242}.track-option b,.track-option small{display:block}.track-option b{color:#282724;font-size:11px}.track-option small{margin-top:4px;color:#77746e;font-size:9px;font-weight:500}.consent{display:flex;gap:9px;margin:20px 0;color:#77746e;font-weight:500;line-height:1.5}.consent input{display:block;width:16px;height:16px;flex:0 0 16px;margin:0}.status{min-height:18px;margin:12px 0 0;color:#9f4141;font-size:11px}
@media(max-width:700px){.hero-inner,.about,.program{width:min(100% - 30px,1180px)}.topline{font-size:8px}.hero-copy{padding:55px 0 65px}.signals{grid-template-columns:1fr 1fr;gap:18px 0}.signals div:nth-child(3){border-left:0;padding-left:0}.about-grid{grid-template-columns:1fr;gap:28px}.about-grid div{border-left:0;border-top:1px solid #d7d5ce;padding:20px 0 0}.program-row{grid-template-columns:35px 1fr;gap:10px}.program-meta{grid-column:2;align-items:flex-start;text-align:left;margin-top:3px}.fields,.track-grid{grid-template-columns:1fr}.modal-panel{padding:25px 20px}.registration-bar{bottom:10px}.closing{padding-bottom:145px}}
</style>
