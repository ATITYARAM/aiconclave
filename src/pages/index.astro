---
const tracks = [
  ['01', 'HPC Industry Innovation Showcase', 'KEC students & faculty', 'Free', '/aiconclave/showcase/'],
  ['02', 'HPC Industry Innovation Challenge', 'Registered teams / external participants', 'Free / nominal cost', '/aiconclave/challenge/'],
  ['03', 'Hands-on Workshops', 'General registered participants', '₹300 one · ₹500 both', '/aiconclave/workshops/']
];

const highlights = [
  ['01', 'Industry Leadership', 'Keynotes, leadership discussion and practical HPC perspectives.'],
  ['02', 'Hands-on Computing', 'Workshops focused on GPU Computing & CUDA and GenAI & LLMs on HPC.'],
  ['03', '24-hour Challenge', 'A continuous industry innovation challenge from 5 to 6 February.'],
  ['04', 'Innovation Showcase', 'KEC students and faculty present their completed or working solutions.']
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>HPC Innovation Conclave 2027</title>
    <meta name="description" content="HPC Innovation Conclave 2027 · 5–6 February 2027 at Kongu Engineering College." />
  </head>
  <body>
    <header class="site-header">
      <nav aria-label="Main navigation">
        <a href="/aiconclave/announcement/">Announcement</a>
        <a href="/aiconclave/about/">About</a>
        <a href="/aiconclave/tracks/">Tracks</a>
        <a href="/aiconclave/event-plan/">Event Plan</a>
        <a href="/aiconclave/showcase/">Showcase</a>
        <a href="/aiconclave/challenge/">Challenge</a>
        <a href="/aiconclave/workshops/">Workshops</a>
      </nav>
    </header>

    <main>
      <section class="hero">
        <div class="hero-inner">
          <div class="topline">
            <span>HPC INNOVATION CONCLAVE 2027</span>
            <span>05–06 FEB 2027 · KEC</span>
          </div>

          <div class="identity-strip">
            <div class="identity-mark"><strong>KEC</strong><span>Kongu Engineering College</span></div>
            <div class="identity-mark"><strong>CSE</strong><span>Association</span></div>
          </div>

          <div class="hero-copy">
            <p class="kicker">CONNECT · COMPUTE · CREATE · SHOWCASE</p>
            <h1>Build with<br /><em>HPC.</em></h1>
            <p class="intro">A two-day HPC-focused conclave bringing together industry leadership, hands-on computing workshops, a 24-hour industry innovation challenge and a showcase of solutions created by KEC students and faculty.</p>
          </div>

          <div class="hero-cards">
            <article class="hero-card hero-card-main">
              <span>THE CONCLAVE</span>
              <strong>05–06</strong>
              <p>February 2027</p>
            </article>
            <article class="hero-card">
              <span>CHALLENGE</span>
              <strong>24H</strong>
              <p>Industry Innovation Challenge</p>
            </article>
            <article class="hero-card">
              <span>WORKSHOPS</span>
              <strong>02</strong>
              <p>Hands-on HPC workshops</p>
            </article>
            <article class="hero-card">
              <span>VENUE</span>
              <strong>KEC</strong>
              <p>Kongu Engineering College</p>
            </article>
          </div>
        </div>
      </section>

      <section class="statement">
        <div class="section-label">THE IDEA</div>
        <div class="statement-grid">
          <h2>Where ideas meet<br /><em>compute.</em></h2>
          <div>
            <p>HPC Innovation Conclave 2027 takes place on <strong>Friday, 5 February and Saturday, 6 February 2027</strong> at Kongu Engineering College.</p>
            <p>The programme moves from keynote and industry leadership discussions into hands-on learning, competitive problem solving and innovation showcase activities.</p>
            <a class="text-link" href="/aiconclave/about/">Read about the Conclave →</a>
          </div>
        </div>
      </section>

      <section class="highlights">
        <div class="section-head">
          <div>
            <span class="section-label">WHAT'S HAPPENING</span>
            <h2>Four ways to<br /><em>build.</em></h2>
          </div>
          <p>One programme, four connected experiences across industry, learning, competition and innovation.</p>
        </div>
        <div class="highlight-grid">
          {highlights.map(([number, title, description], index) => (
            <article class={`floating-card ${index % 2 === 1 ? 'lifted' : ''}`}>
              <span class="card-number">{number}</span>
              <div>
                <h3>{title}</h3>
                <p>{description}</p>
              </div>
            </article>
          ))}
        </div>
      </section>

      <section class="tracks">
        <div class="section-head compact">
          <div>
            <span class="section-label">THREE TRACKS</span>
            <h2>Choose how<br /><em>you participate.</em></h2>
          </div>
          <a class="text-link" href="/aiconclave/tracks/">View all tracks →</a>
        </div>
        <div class="track-grid">
          {tracks.map(([number, title, who, fee, href], index) => (
            <a class={`track-card ${index === 1 ? 'dark' : ''} ${index === 2 ? 'lifted' : ''}`} href={href}>
              <div class="track-top"><span>{number}</span><strong>{fee}</strong></div>
              <div>
                <small>{who}</small>
                <h3>{title}</h3>
              </div>
              <span class="arrow">↗</span>
            </a>
          ))}
        </div>
      </section>

      <section class="event-plan">
        <div class="section-label">EVENT PLAN</div>
        <div class="days-grid">
          <article class="day-card">
            <span>DAY 01 · 05 FEB</span>
            <h3>Connect &amp;<br /><em>Explore.</em></h3>
            <p>Inauguration · HPC Keynote · Industry Leadership Panel · GPU Computing &amp; CUDA · Challenge Launch</p>
          </article>
          <article class="day-card lifted">
            <span>DAY 02 · 06 FEB</span>
            <h3>Build &amp;<br /><em>Showcase.</em></h3>
            <p>GenAI &amp; LLMs on HPC · Innovation Showcase · Careers &amp; Certifications · Challenge Evaluation · Closing</p>
          </article>
        </div>
        <a class="text-link" href="/aiconclave/event-plan/">See the complete event plan →</a>
      </section>

      <section class="closing">
        <p>HPC INNOVATION CONCLAVE 2027 · 05–06 FEBRUARY</p>
        <h2>Connect.<br /><em>Compute. Create.</em></h2>
        <p>Explore the programme and choose your participation track.</p>
      </section>
    </main>

    <div class="registration-bar">
      <div>
        <span>HPC INNOVATION CONCLAVE 2027</span>
        <strong>Choose your track</strong>
      </div>
      <button class="register-button" id="register-open" type="button">Register <span>↗</span></button>
    </div>

    <div class="rules-modal" id="rules-modal" aria-hidden="true">
      <div class="rules-backdrop" data-rules-close></div>
      <section class="rules-panel" role="dialog" aria-modal="true" aria-labelledby="rules-title">
        <button class="rules-close" type="button" aria-label="Close" data-rules-close>×</button>
        <p class="kicker">BEFORE YOU REGISTER</p>
        <h2 id="rules-title">Rules &amp;<br /><em>constraints.</em></h2>
        <p class="rules-intro">Please read the participation rules before continuing to the registration and payment page.</p>
        <div class="rule-list">
          <div><b>01</b><span>Participation is restricted to <strong>one track only</strong> — Showcase, Challenge, or Workshops.</span></div>
          <div><b>02</b><span>Cross-participation across tracks is not permitted.</span></div>
          <div><b>03</b><span>Challenge participants cannot participate in the Hands-on Workshops on either day.</span></div>
          <div><b>04</b><span>All participants must complete registration in advance and carry valid registration confirmation / ID.</span></div>
          <div><b>05</b><span>Showcase is for KEC students and faculty and requires a completed / working solution.</span></div>
          <div><b>06</b><span>The Challenge runs continuously for 24 hours from 2:15 PM on 5 February to 2:15 PM on 6 February.</span></div>
          <div><b>07</b><span>Workshops cost ₹300 for one workshop or ₹500 for both; participants should bring their own laptop.</span></div>
          <div><b>08</b><span>Lunch is provided only for participants of the 24-hour Innovation Challenge.</span></div>
        </div>
        <div class="countdown-wrap"><span id="countdown">30</span><small>seconds remaining before continuing</small></div>
        <button id="rules-continue" class="rules-continue" type="button" disabled>Continue to registration <span>→</span></button>
        <p id="wait-note" class="wait-note">The registration button will unlock after the 30-second review period.</p>
      </section>
    </div>

    <script>
      const modal = document.getElementById('rules-modal');
      const openButton = document.getElementById('register-open');
      const continueButton = document.getElementById('rules-continue');
      const countdown = document.getElementById('countdown');
      let timer;

      function closeRules() {
        modal?.setAttribute('aria-hidden', 'true');
        modal?.classList.remove('ready');
        document.body.style.overflow = '';
        clearInterval(timer);
      }

      openButton?.addEventListener('click', () => {
        modal?.setAttribute('aria-hidden', 'false');
        document.body.style.overflow = 'hidden';
        continueButton.disabled = true;
        countdown.textContent = '30';
        modal.classList.remove('ready');
        let remaining = 30;
        clearInterval(timer);
        timer = setInterval(() => {
          remaining -= 1;
          countdown.textContent = String(remaining);
          if (remaining <= 0) {
            clearInterval(timer);
            continueButton.disabled = false;
            modal.classList.add('ready');
            document.getElementById('wait-note').textContent = 'You can now continue to registration.';
          }
        }, 1000);
      });

      document.querySelectorAll('[data-rules-close]').forEach((element) => element.addEventListener('click', closeRules));
      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') closeRules();
      });
      continueButton?.addEventListener('click', () => {
        if (!continueButton.disabled) window.location.href = '/aiconclave/registration-details/';
      });
    </script>
  </body>
</html>

