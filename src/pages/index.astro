---
const tracks = [
  { id: 'golang', title: 'GoLang Framework', detail: 'Workshop 1', meta: '13 Mar · 1:30–4:30 PM' },
  { id: 'genai', title: 'GenAI in Action', detail: 'Workshop 2', meta: '14 Mar · 9:30 AM–12:30 PM' },
  { id: 'hackathon', title: '24 hrs Hackathon', detail: 'Given problem statements', meta: '13–14 Mar · 1:00 PM–1:00 PM' },
  { id: 'pitch', title: 'Pitch Your Idea', detail: 'Early-stage startups & students · TRL 4+', meta: '13 Mar · 11:00 AM–1:30 PM' }
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>AI Conclave 1.0 · Shape the Next Reality</title>
    <meta name="description" content="AI Conclave 1.0 at Kongu Engineering College — workshops, hackathon and startup pitch." />
  </head>
  <body>
    <main>
      <section class="hero">
        <div class="hero-inner">
          <div class="topline"><span>AI CONCLAVE 1.0</span><span>13–14 MAR 2025 · KEC</span></div>
          <div class="hero-copy">
            <p class="kicker">KONGU ENGINEERING COLLEGE</p>
            <h1>Shape the<br /><em>next reality.</em></h1>
            <p class="intro">Two days of artificial intelligence, innovation and entrepreneurship — bringing together students, builders, researchers and founders at Maharaja Auditorium, KEC.</p>
          </div>
          <div class="signals">
            <div><strong>04</strong><span>Experiences</span></div><div><strong>24H</strong><span>Hackathon</span></div><div><strong>02</strong><span>Workshops</span></div><div><strong>01</strong><span>Pitch Arena</span></div>
          </div>
        </div>
      </section>

      <section class="program">
        <div class="section-label">THE PROGRAM</div>
        <div class="program-list">
          {tracks.map((track, index) => (
            <article class="program-row"><span class="number">0{index + 1}</span><div><small>{track.detail}</small><h2>{track.title}</h2></div><span class="program-meta">{track.meta}</span></article>
          ))}
        </div>
        <p class="source-note">Organised by Dept. of AI in association with Innovation &amp; Entrepreneurship Forum (IEF).</p>
      </section>

      <section class="closing"><p>MAHARAJA AUDITORIUM · KONGU ENGINEERING COLLEGE</p><h2>Be in the room<br />where ideas move.</h2></section>
    </main>

    <div class="registration-bar"><div class="bar-copy"><span>AI CONCLAVE 1.0</span><strong>Registration is your first step.</strong></div><button id="open-registration" class="register-button">Register &amp; Pay <span>↗</span></button></div>

    <div id="registration-modal" class="modal" aria-hidden="true">
      <div class="modal-backdrop" data-close></div>
      <section class="modal-panel" role="dialog" aria-modal="true" aria-labelledby="registration-title">
        <button class="close" type="button" aria-label="Close registration" data-close>×</button>
        <div class="modal-header"><p class="kicker">REGISTRATION · 01 / 02</p><h2 id="registration-title">Reserve your place.</h2><p>Enter your details and choose what you want to attend. Payment is the final confirmation step.</p></div>
        <form id="registration-form">
          <div class="fields">
            <label>Full name *<input name="name" required autocomplete="name" placeholder="Your full name" /></label>
            <label>Email *<input name="email" type="email" required autocomplete="email" placeholder="you@example.com" /></label>
            <label>Mobile *<input name="phone" type="tel" required autocomplete="tel" placeholder="+91 XXXXX XXXXX" /></label>
            <label>Institution / Organisation *<input name="institution" required placeholder="College, startup or organisation" /></label>
            <label>I am a *<select name="role" required><option value="">Select one</option><option>Student</option><option>Faculty / Researcher</option><option>Startup / Founder</option><option>Industry Professional</option><option>Other</option></select></label>
            <label>City<input name="city" placeholder="Your city" /></label>
          </div>
          <div class="choose"><div><p class="kicker">PARTICIPATION</p><h3>Select your experiences</h3></div><div class="track-grid">
            {tracks.map((track) => <label class="track-option"><input type="checkbox" name="tracks" value={track.id} /><span class="box"></span><span><b>{track.title}</b><small>{track.meta}</small></span></label>)}
          </div></div>
          <label class="consent"><input type="checkbox" required /> <span>I confirm the information is accurate and agree to be contacted by the organisers.</span></label>
          <div class="payment-preview"><div class="payment-icon">₹</div><div><b>Secure payment</b><span>Your registration will be confirmed after successful payment.</span></div><strong>→</strong></div>
          <button class="continue" type="submit">Continue to payment <span>→</span></button><p id="status" class="status" aria-live="polite"></p>
        </form>
        <p class="payment-note">Payment gateway integration is prepared for the next step. No payment is collected by this static page until the organiser's live payment gateway/link is configured.</p>
      </section>
    </div>

    <script>
      const modal = document.querySelector('#registration-modal');
      const openButton = document.querySelector('#open-registration');
      const form = document.querySelector('#registration-form');
      const status = document.querySelector('#status');
      const closeModal = () => { modal?.setAttribute('aria-hidden', 'true'); document.body.classList.remove('locked'); };
      openButton?.addEventListener('click', () => { modal?.setAttribute('aria-hidden', 'false'); document.body.classList.add('locked'); setTimeout(() => modal?.querySelector('input')?.focus(), 50); });
      modal?.querySelectorAll('[data-close]').forEach((el) => el.addEventListener('click', closeModal));
      document.addEventListener('keydown', (event) => { if (event.key === 'Escape') closeModal(); });
      form?.addEventListener('submit', (event) => { event.preventDefault(); status.textContent = 'Payment gateway is the next connection. The form is ready for Supabase + the organiser payment link.'; });
    </script>
  </body>
</html>

<style>
  :global(*) { box-sizing: border-box; }
  :global(html) { scroll-behavior: smooth; }
  :global(body) { margin: 0; background: #07080a; color: #f4f1ed; font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; }
  :global(body.locked) { overflow: hidden; }
  :global(button), :global(input), :global(select) { font: inherit; }
  .hero { min-height: 86vh; border-bottom: 1px solid #252525; background: radial-gradient(circle at 72% 22%, rgba(157,42,42,.20), transparent 30%), linear-gradient(145deg,#090a0c,#101114 65%,#090a0c); }
  .hero-inner { width: min(1180px,calc(100% - 44px)); min-height: 86vh; margin: auto; padding: 30px 0 54px; display: flex; flex-direction: column; }
  .topline { display: flex; justify-content: space-between; border-bottom: 1px solid #2a2a2a; padding-bottom: 17px; color: #85827e; font-size: 10px; font-weight: 800; letter-spacing: .2em; }
  .hero-copy { margin: auto 0; padding: 70px 0 80px; }
  .kicker,.section-label { margin: 0; color: #b75b5b; font-size: 10px; font-weight: 850; letter-spacing: .2em; }
  h1 { margin: 16px 0 24px; font-size: clamp(64px,11vw,150px); line-height: .82; letter-spacing: -.075em; font-weight: 780; }
  h1 em { color: #b64e4e; font-family: Georgia,serif; font-weight: 400; }
  .intro { max-width: 600px; margin: 0; color: #a09d99; font-size: clamp(15px,1.6vw,19px); line-height: 1.65; }
  .signals { display: grid; grid-template-columns: repeat(4,1fr); border-top: 1px solid #2a2a2a; padding-top: 18px; }
  .signals div { display: flex; flex-direction: column; gap: 4px; border-left: 1px solid #2a2a2a; padding-left: 18px; }.signals div:first-child { border-left: 0; padding-left: 0; }
  .signals strong { font-size: 22px; letter-spacing: -.03em; }.signals span { color: #77746f; font-size: 10px; text-transform: uppercase; letter-spacing: .12em; }
  .program { width: min(1180px,calc(100% - 44px)); margin: auto; padding: 110px 0 120px; }.program-list { margin-top: 30px; border-top: 1px solid #292929; }
  .program-row { display: grid; grid-template-columns: 70px 1fr auto; gap: 20px; align-items: center; padding: 28px 0; border-bottom: 1px solid #292929; }.number { color: #6e6b67; font-size: 11px; }
  .program-row small { color: #797671; font-size: 10px; text-transform: uppercase; letter-spacing: .12em; }.program-row h2 { margin: 7px 0 0; font-size: clamp(23px,3vw,38px); letter-spacing: -.045em; }.program-meta { color: #77736e; font-size: 11px; text-align: right; }
  .source-note { margin-top: 22px; color: #5f5c58; font-size: 11px; }.closing { min-height: 55vh; display: flex; flex-direction: column; justify-content: center; align-items: center; text-align: center; border-top: 1px solid #252525; padding: 80px 22px 170px; }
  .closing p { color: #706d68; font-size: 10px; letter-spacing: .18em; }.closing h2 { margin: 20px 0 0; font-size: clamp(48px,8vw,100px); line-height: .9; letter-spacing: -.065em; }
  .registration-bar { position: fixed; z-index: 20; left: 50%; bottom: 18px; transform: translateX(-50%); width: min(1050px,calc(100% - 28px)); padding: 12px 13px 12px 20px; display: flex; align-items: center; justify-content: space-between; gap: 20px; border: 1px solid #3a3a3a; border-radius: 15px; background: rgba(16,17,20,.92); backdrop-filter: blur(18px); box-shadow: 0 18px 70px rgba(0,0,0,.55); }
  .bar-copy { display: flex; flex-direction: column; gap: 3px; }.bar-copy span { color: #9a4949; font-size: 9px; font-weight: 850; letter-spacing: .18em; }.bar-copy strong { font-size: 13px; }
  .register-button,.continue { border: 0; border-radius: 9px; background: #b04d4d; color: #fff; padding: 14px 19px; font-weight: 800; cursor: pointer; }.register-button:hover,.continue:hover { background: #c15a5a; }.register-button span,.continue span { margin-left: 14px; }
  .modal { position: fixed; z-index: 40; inset: 0; display: none; }.modal[aria-hidden="false"] { display: block; }.modal-backdrop { position: absolute; inset: 0; background: rgba(0,0,0,.76); backdrop-filter: blur(9px); }
  .modal-panel { position: absolute; top: 50%; left: 50%; transform: translate(-50%,-50%); width: min(760px,calc(100% - 28px)); max-height: calc(100vh - 34px); overflow: auto; border: 1px solid #303136; border-radius: 18px; background: #101114; box-shadow: 0 30px 100px rgba(0,0,0,.65); padding: 32px; }
  .close { position: absolute; top: 16px; right: 17px; border: 0; background: transparent; color: #87888c; font-size: 28px; cursor: pointer; }.modal-header { padding-right: 35px; padding-bottom: 25px; border-bottom: 1px solid #292a2e; }.modal-header h2 { margin: 10px 0 8px; font-size: clamp(34px,5vw,52px); letter-spacing: -.06em; }.modal-header p:last-child { max-width: 560px; margin: 0; color: #8e9096; font-size: 13px; line-height: 1.6; }
  form { padding-top: 25px; }.fields { display: grid; grid-template-columns: 1fr 1fr; gap: 15px; }label { color: #bdbec2; font-size: 11px; font-weight: 700; }input,select { display: block; width: 100%; margin-top: 7px; border: 1px solid #303238; border-radius: 9px; outline: none; background: #08090b; color: #f2f2f3; padding: 12px 13px; }input::placeholder { color: #555860; }input:focus,select:focus { border-color: #a54c4c; }
  .choose { margin-top: 27px; padding-top: 25px; border-top: 1px solid #292a2e; }.choose h3 { margin: 7px 0 15px; font-size: 17px; }.track-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 9px; }.track-option { display: flex; align-items: flex-start; gap: 10px; padding: 12px; border: 1px solid #2b2d32; border-radius: 9px; cursor: pointer; }.track-option:has(input:checked) { border-color: #8e4141; background: #160e0f; }.track-option input { display: none; }
  .box { width: 16px; height: 16px; flex: 0 0 16px; border: 1px solid #494c53; border-radius: 4px; margin-top: 1px; }.track-option:has(input:checked) .box { background: #a94b4b; box-shadow: inset 0 0 0 3px #160e0f; border-color: #a94b4b; }.track-option b,.track-option small { display: block; }.track-option b { color: #e4e5e7; font-size: 11px; }.track-option small { margin-top: 4px; color: #73767e; font-size: 9px; font-weight: 500; }
  .consent { display: flex; gap: 9px; margin: 20px 0; color: #777a82; font-weight: 500; line-height: 1.5; }.consent input { display: block; width: 16px; height: 16px; flex: 0 0 16px; margin: 1px 0 0; accent-color: #a94b4b; }.payment-preview { display: flex; align-items: center; gap: 12px; border: 1px solid #292c31; border-radius: 10px; padding: 13px; margin-bottom: 12px; }.payment-icon { width: 34px; height: 34px; display: grid; place-items: center; border-radius: 50%; background: #1d1112; color: #ca6a6a; font-weight: 850; }.payment-preview div:nth-child(2) { display: flex; flex-direction: column; gap: 3px; flex: 1; }.payment-preview b { font-size: 11px; }.payment-preview span { color: #6f737b; font-size: 10px; }.payment-preview > strong { color: #777a80; }
  .continue { width: 100%; }.status { min-height: 18px; margin: 12px 0 0; color: #a6a8ae; font-size: 11px; }.payment-note { margin: 17px 0 0; color: #5e6168; font-size: 9px; line-height: 1.55; text-align: center; }
  @media (max-width: 700px) { .hero-inner,.program { width: min(100% - 28px,1180px); }.topline span:last-child { display: none; }.hero-copy { padding: 70px 0; }.signals { grid-template-columns: 1fr 1fr; gap: 18px 0; }.signals div:nth-child(3) { border-left: 0; padding-left: 0; }.program-row { grid-template-columns: 35px 1fr; gap: 10px; }.program-meta { grid-column: 2; text-align: left; }.registration-bar { bottom: 10px; }.bar-copy strong { font-size: 11px; }.register-button { padding: 12px 14px; font-size: 11px; }.modal-panel { padding: 24px 18px; }.fields,.track-grid { grid-template-columns: 1fr; } }
</style>
