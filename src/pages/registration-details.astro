---
const tracks = [
  { id: 'showcase', number: '01', title: 'HPC Industry Innovation Showcase', audience: 'KEC students & faculty', price: 0, priceLabel: 'Free' },
  { id: 'challenge', number: '02', title: 'HPC Industry Innovation Challenge', audience: 'Registered teams / external participants', price: 0, priceLabel: 'Free / nominal' },
  { id: 'workshops', number: '03', title: 'Hands-on Workshops', audience: 'General registered participants', price: 0, priceLabel: '₹300 one · ₹500 both' }
];
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Registration · HPC Innovation Conclave 2027</title>
  <meta name="description" content="Register for HPC Innovation Conclave 2027 at Kongu Engineering College." />
</head>
<body>
  <header class="site-header">
    <a class="brand" href="/aiconclave/">HPC INNOVATION CONCLAVE 2027</a>
    <a class="back" href="/aiconclave/">← Back to Conclave</a>
  </header>

  <main>
    <section class="hero">
      <div class="hero-meta"><span>REGISTRATION</span><span>05–06 FEB 2027 · KEC</span></div>
      <p class="eyebrow">ONE REGISTRATION · ONE TRACK</p>
      <h1>Choose your<br /><em>experience.</em></h1>
      <p class="intro">Complete your participant details, select exactly one participation track, and review the final amount before continuing to the secure payment step.</p>
    </section>

    <section class="registration-shell">
      <div class="rule-banner">
        <div class="rule-index">RULE</div>
        <div><strong>One track only.</strong><span>Cross-participation is not permitted. Challenge participants cannot participate in the Hands-on Workshops.</span></div>
      </div>

      <form id="registration-form" novalidate>
        <section class="form-section">
          <div class="section-title"><span>01</span><div><p>PARTICIPANT DETAILS</p><h2>Tell us about you.</h2></div></div>
          <div class="fields">
            <label>Full name *<input name="name" required autocomplete="name" placeholder="Your full name" /></label>
            <label>Email address *<input name="email" type="email" required autocomplete="email" placeholder="you@example.com" /></label>
            <label>Mobile number *<input name="phone" type="tel" inputmode="numeric" required autocomplete="tel" maxlength="10" placeholder="10-digit mobile number" /></label>
            <label>Institution / Organisation *<input name="institution" required placeholder="Institution or organisation" /></label>
            <label>City<input name="city" autocomplete="address-level2" placeholder="City" /></label>
            <label>Participant type *
              <select name="participantType" required>
                <option value="">Select type</option>
                <option>Student</option><option>Faculty</option><option>Researcher</option><option>Industry Professional</option><option>Startup / Founder</option><option>Other</option>
              </select>
            </label>
          </div>
        </section>

        <section class="form-section">
          <div class="section-title"><span>02</span><div><p>PARTICIPATION</p><h2>Select one track.</h2></div></div>
          <div class="track-list">
            {tracks.map((track) => (
              <label class="track-card" data-track={track.id}>
                <input type="radio" name="track" value={track.id} required />
                <span class="track-radio" aria-hidden="true"></span>
                <span class="track-copy"><small>{track.number} · {track.audience}</small><strong>{track.title}</strong><span>{track.id === 'challenge' ? '24-hour industry innovation challenge' : track.id === 'workshops' ? 'GPU Computing & CUDA + GenAI & LLMs on HPC' : 'Completed or working solutions from KEC'}</span></span>
                <b class="track-price">{track.priceLabel}</b>
              </label>
            ))}
          </div>
        </section>

        <section id="workshop-section" class="conditional-section" hidden>
          <div class="conditional-head"><span class="section-number">03</span><div><p>WORKSHOP SELECTION</p><h2>Build your workshop pass.</h2></div></div>
          <p class="conditional-note">Choose one workshop for ₹300 or both workshops for ₹500. A laptop is expected for hands-on sessions.</p>
          <div class="workshop-list">
            <label class="choice-card"><input type="checkbox" name="workshops" value="cuda" /><span class="check" aria-hidden="true">✓</span><span><strong>GPU Computing &amp; CUDA</strong><small>Day 1 · 05 February</small></span></label>
            <label class="choice-card"><input type="checkbox" name="workshops" value="genai" /><span class="check" aria-hidden="true">✓</span><span><strong>Generative AI &amp; LLMs on HPC</strong><small>Day 2 · 06 February</small></span></label>
          </div>
        </section>

        <section id="challenge-section" class="conditional-section" hidden>
          <div class="conditional-head"><span class="section-number">03</span><div><p>CHALLENGE DETAILS</p><h2>Identify your team.</h2></div></div>
          <div class="challenge-grid">
            <label>Team name *<input name="teamName" placeholder="Your team name" /></label>
            <div class="challenge-note"><strong>24 HOURS</strong><span>Challenge runs from <b>2:15 PM · 05 Feb</b> to <b>2:15 PM · 06 Feb</b>.</span></div>
          </div>
          <p class="conditional-note">Challenge participants are not eligible to participate in the Hands-on Workshops. Lunch is provided only for participants of the 24-hour Innovation Challenge.</p>
        </section>

        <section class="review-section">
          <div class="section-title"><span>04</span><div><p>REGISTRATION SUMMARY</p><h2>Review before payment.</h2></div></div>
          <div class="summary">
            <div><span>Selected track</span><strong id="summary-track">Not selected</strong></div>
            <div><span>Workshop selection</span><strong id="summary-workshops">—</strong></div>
            <div><span>Registration amount</span><strong id="summary-amount">₹0</strong></div>
          </div>
        </section>

        <label class="consent"><input id="consent" type="checkbox" required /><span>I have read the participation rules and confirm that I am registering for <strong>one track only</strong>. I understand the selected track and applicable fee.</span></label>

        <div class="submit-area">
          <button id="submit-button" class="pay" type="submit" disabled>Continue <span>→</span></button>
          <p id="payment-state" class="payment-state"><span class="state-dot"></span>Select a track to continue.</p>
        </div>
        <p id="status" class="status" aria-live="polite"></p>
      </form>
    </section>
  </main>

  <footer><span>HPC INNOVATION CONCLAVE 2027</span><span>Kongu Engineering College · 05–06 February 2027</span></footer>

  <script>
    const form = document.querySelector('#registration-form');
    const trackInputs = document.querySelectorAll('input[name="track"]');
    const workshopInputs = document.querySelectorAll('input[name="workshops"]');
    const workshopSection = document.querySelector('#workshop-section');
    const challengeSection = document.querySelector('#challenge-section');
    const teamInput = document.querySelector('input[name="teamName"]');
    const consent = document.querySelector('#consent');
    const submitButton = document.querySelector('#submit-button');
    const summaryTrack = document.querySelector('#summary-track');
    const summaryWorkshops = document.querySelector('#summary-workshops');
    const summaryAmount = document.querySelector('#summary-amount');
    const paymentState = document.querySelector('#payment-state');
    const status = document.querySelector('#status');

    const labels = { showcase: 'HPC Industry Innovation Showcase', challenge: 'HPC Industry Innovation Challenge', workshops: 'Hands-on Workshops' };

    function selectedTrack() {
      return document.querySelector('input[name="track"]:checked')?.value || '';
    }

    function workshopCount() {
      return [...workshopInputs].filter((input) => input.checked).length;
    }

    function amount() {
      const track = selectedTrack();
      if (track !== 'workshops') return 0;
      return workshopCount() === 1 ? 300 : workshopCount() === 2 ? 500 : 0;
    }

    function updateSummary() {
      const track = selectedTrack();
      const count = workshopCount();
      const total = amount();
      summaryTrack.textContent = track ? labels[track] : 'Not selected';
      summaryWorkshops.textContent = track !== 'workshops' ? 'Not applicable' : count === 0 ? 'Choose at least one' : count === 1 ? '1 workshop · ₹300' : '2 workshops · ₹500';
      summaryAmount.textContent = `₹${total}`;

      const validWorkshop = track !== 'workshops' || count > 0;
      const validChallenge = track !== 'challenge' || teamInput.value.trim().length > 0;
      submitButton.disabled = !(track && validWorkshop && validChallenge && consent.checked);

      if (!track) paymentState.innerHTML = '<span class="state-dot"></span>Select a track to continue.';
      else if (!validWorkshop) paymentState.innerHTML = '<span class="state-dot"></span>Select one or both workshops.';
      else if (!validChallenge) paymentState.innerHTML = '<span class="state-dot"></span>Enter your challenge team name.';
      else if (total > 0) paymentState.innerHTML = `<span class="state-dot"></span>Payment required · ₹${total} via secure PhonePe checkout.`;
      else paymentState.innerHTML = '<span class="state-dot"></span>No payment required for this selection.';
    }

    function updateConditionalSections() {
      const track = selectedTrack();
      workshopSection.hidden = track !== 'workshops';
      challengeSection.hidden = track !== 'challenge';
      teamInput.required = track === 'challenge';
      workshopInputs.forEach((input) => { input.required = false; });
      updateSummary();
    }

    trackInputs.forEach((input) => input.addEventListener('change', updateConditionalSections));
    workshopInputs.forEach((input) => input.addEventListener('change', updateSummary));
    teamInput.addEventListener('input', updateSummary);
    consent.addEventListener('change', updateSummary);

    form.addEventListener('submit', (event) => {
      event.preventDefault();
      status.className = 'status';
      status.textContent = '';
      if (!form.reportValidity()) return;

      const total = amount();
      if (total > 0) {
        status.textContent = `Registration details validated. PhonePe checkout will be opened here once the secure merchant order API is connected. Amount: ₹${total}.`;
      } else {
        status.textContent = 'Registration details validated. This free registration is ready for secure submission once the registration API is connected.';
      }
    });

    updateConditionalSections();
  </script>
</body>
</html>

