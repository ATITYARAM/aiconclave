---
const tracks = [
  { id: 'showcase', number: '01', title: 'HPC Industry Innovation Showcase', audience: 'KEC students & faculty', priceLabel: 'Free' },
  { id: 'challenge', number: '02', title: 'HPC Industry Innovation Challenge', audience: 'Registered teams / external participants', priceLabel: 'Free / nominal' },
  { id: 'workshops', number: '03', title: 'Hands-on Workshops', audience: 'General registered participants', priceLabel: '₹300 one · ₹500 both' }
];
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="theme-color" content="#f7f6f2" />
  <title>Registration · HPC Innovation Conclave 2027</title>
</head>
<body>
  <a class="skip-link" href="#registration-form">Skip to registration form</a>
  <header><a href="/aiconclave/">HPC INNOVATION CONCLAVE 2027</a><a href="/aiconclave/">← Back to Conclave</a></header>
  <main>
    <section class="hero">
      <div class="hero-grid" aria-hidden="true"></div>
      <div class="meta"><span>REGISTRATION</span><span>05–06 FEB 2027 · KEC</span></div>
      <p class="eyebrow">ONE REGISTRATION · ONE TRACK</p>
      <h1>Choose your<br><em>experience.</em></h1>
      <p class="intro">Complete your details, select exactly one participation track, and continue to secure PhonePe checkout when a fee applies.</p>
    </section>
    <section class="card">
      <div class="rule"><b>ONE TRACK ONLY</b><span>Cross-participation is not permitted. Challenge participants cannot participate in the Hands-on Workshops.</span></div>
      <form id="registration-form" novalidate aria-describedby="form-status">
        <div class="section"><div class="section-head"><span>01</span><div><small>PARTICIPANT DETAILS</small><h2>Tell us about you.</h2></div></div>
          <div class="fields">
            <label>Full name *<input name="name" required autocomplete="name" placeholder="Your full name"></label>
            <label>Email address *<input name="email" type="email" required autocomplete="email" placeholder="you@example.com"></label>
            <label>Mobile number *<input name="phone" type="tel" inputmode="numeric" pattern="[0-9]{10}" maxlength="10" required autocomplete="tel" placeholder="10-digit mobile number"></label>
            <label>Institution / Organisation *<input name="institution" required autocomplete="organization" placeholder="Institution or organisation"></label>
            <label>City<input name="city" autocomplete="address-level2" placeholder="City"></label>
            <label>Participant type *<select name="participantType" required><option value="">Select type</option><option>Student</option><option>Faculty</option><option>Researcher</option><option>Industry Professional</option><option>Startup / Founder</option><option>Other</option></select></label>
          </div>
        </div>
        <div class="section"><div class="section-head"><span>02</span><div><small>PARTICIPATION</small><h2>Select one track.</h2></div></div>
          <div class="tracks">{tracks.map((track) => <label class="track"><input type="radio" name="track" value={track.id} required><i aria-hidden="true"></i><span><small>{track.number} · {track.audience}</small><b>{track.title}</b><em>{track.id === 'challenge' ? '24-hour industry innovation challenge' : track.id === 'workshops' ? 'GPU Computing & CUDA + GenAI & LLMs on HPC' : 'Completed or working solutions from KEC'}</em></span><strong>{track.priceLabel}</strong></label>)}</div>
        </div>
        <div id="workshop-section" class="conditional" hidden><div class="section-head"><span>03</span><div><small>WORKSHOP SELECTION</small><h2>Build your workshop pass.</h2></div></div><p>Choose one workshop for ₹300 or both for ₹500. A laptop is expected.</p><div class="choices"><label><input type="checkbox" name="workshops" value="cuda"><span aria-hidden="true">✓</span><b>GPU Computing & CUDA</b><small>Day 1 · 05 February</small></label><label><input type="checkbox" name="workshops" value="genai"><span aria-hidden="true">✓</span><b>Generative AI & LLMs on HPC</b><small>Day 2 · 06 February</small></label></div></div>
        <div id="challenge-section" class="conditional" hidden><div class="section-head"><span>03</span><div><small>CHALLENGE DETAILS</small><h2>Identify your team.</h2></div></div><label>Team name *<input name="teamName" autocomplete="off" placeholder="Your team name"></label><p>24-hour challenge: 2:15 PM · 05 Feb → 2:15 PM · 06 Feb. Lunch is provided only for Challenge participants.</p></div>
        <div class="section"><div class="section-head"><span>04</span><div><small>REGISTRATION SUMMARY</small><h2>Review before payment.</h2></div></div><div class="summary"><div><span>Selected track</span><b id="summary-track">Not selected</b></div><div><span>Workshop selection</span><b id="summary-workshops">—</b></div><div><span>Registration amount</span><b id="summary-amount">₹0</b></div></div></div>
        <label class="consent"><input id="consent" type="checkbox" required><span>I have read the rules and confirm that I am registering for <b>one track only</b>.</span></label>
        <button id="submit-button" type="submit" disabled><span class="button-label">Continue</span><span class="button-arrow" aria-hidden="true">→</span><span class="spinner" aria-hidden="true"></span></button>
        <p id="state" class="state" aria-live="polite">Select a track to continue.</p><p id="status" class="status" role="status" aria-live="polite"></p>
      </form>
    </section>
  </main>
  <footer>HPC INNOVATION CONCLAVE 2027 · Kongu Engineering College · 05–06 February 2027</footer>
  <script>
    const SUPABASE_URL='https://zepdglebhboorspdqnub.supabase.co';
    const SUPABASE_KEY='sb_publishable_Z0J-eFYKQSkGA7XOw5FbWw_gM9OVd2U';
    const form=document.querySelector('#registration-form'); const tracks=document.querySelectorAll('input[name="track"]'); const workshops=document.querySelectorAll('input[name="workshops"]'); const workshopSection=document.querySelector('#workshop-section'); const challengeSection=document.querySelector('#challenge-section'); const team=document.querySelector('input[name="teamName"]'); const consent=document.querySelector('#consent'); const submit=document.querySelector('#submit-button'); const state=document.querySelector('#state'); const status=document.querySelector('#status'); const labels={showcase:'HPC Industry Innovation Showcase',challenge:'HPC Industry Innovation Challenge',workshops:'Hands-on Workshops'};
    const track=()=>document.querySelector('input[name="track"]:checked')?.value||''; const count=()=>[...workshops].filter(x=>x.checked).length; const amount=()=>track()!=='workshops'?0:(count()===1?300:count()===2?500:0);
    function update(){const t=track(),c=count(),a=amount(); workshopSection.hidden=t!=='workshops'; challengeSection.hidden=t!=='challenge'; team.required=t==='challenge'; document.querySelector('#summary-track').textContent=t?labels[t]:'Not selected'; document.querySelector('#summary-workshops').textContent=t!=='workshops'?'Not applicable':c===0?'Choose at least one':c===1?'1 workshop · ₹300':'2 workshops · ₹500'; document.querySelector('#summary-amount').textContent=`₹${a}`; const valid=t&&(t!=='workshops'||c>0)&&(t!=='challenge'||team.value.trim())&&consent.checked; submit.disabled=!valid; if(!submit.dataset.loading){state.textContent=!t?'Select a track to continue.':t==='workshops'&&c===0?'Select one or both workshops.':t==='challenge'&&!team.value.trim()?'Enter your challenge team name.':a?'Payment required · ₹'+a+' via secure PhonePe checkout.':'No payment required for this selection.';}}
    tracks.forEach(x=>x.addEventListener('change',update)); workshops.forEach(x=>x.addEventListener('change',update)); team.addEventListener('input',update); consent.addEventListener('change',update); update();
    form.addEventListener('submit',async(e)=>{e.preventDefault();status.textContent='';status.className='status';if(!form.reportValidity())return;submit.disabled=true;submit.dataset.loading='true';submit.setAttribute('aria-busy','true');submit.querySelector('.button-label').textContent='Processing…';submit.querySelector('.button-arrow').hidden=true;state.textContent='Creating secure registration…';try{const t=track(), selected=[...workshops].filter(x=>x.checked).map(x=>x.value);const workshopOption=selected.length===2?'both':selected[0]==='cuda'?'gpu_cuda':selected[0]==='genai'?'genai_llm':null;const payload={fullName:form.name.value.trim(),email:form.email.value.trim(),mobile:form.phone.value.replace(/\D/g,''),institution:form.institution.value.trim(),city:form.city.value.trim(),participantType:form.participantType.value,track:t,workshopOption,challengeTeamName:t==='challenge'?team.value.trim():null};const r=await fetch(`${SUPABASE_URL}/functions/v1/create-registration`,{method:'POST',headers:{apikey:SUPABASE_KEY,Authorization:`Bearer ${SUPABASE_KEY}`,'Content-Type':'application/json'},body:JSON.stringify(payload)});const d=await r.json();if(!r.ok)throw new Error(d.error||'Registration failed');if(d.paymentRequired){state.textContent='Creating secure PhonePe checkout…';const p=await fetch(`${SUPABASE_URL}/functions/v1/create-payment-order`,{method:'POST',headers:{apikey:SUPABASE_KEY,Authorization:`Bearer ${SUPABASE_KEY}`,'Content-Type':'application/json'},body:JSON.stringify({registrationId:d.registrationId})});const pd=await p.json();if(!p.ok)throw new Error(pd.error||'Unable to create payment order');location.href=pd.checkoutUrl;return;}location.href=`/aiconclave/payment-status/?registration=${encodeURIComponent(d.registrationId)}`;}catch(err){submit.disabled=false;delete submit.dataset.loading;submit.removeAttribute('aria-busy');submit.querySelector('.button-label').textContent='Try again';submit.querySelector('.button-arrow').hidden=false;state.textContent='Unable to continue.';status.textContent=err.message||'Please try again.';status.className='status error';}});
  </script>
</body>
</html>
<style>
:global(*){box-sizing:border-box}
:global(html){scroll-behavior:smooth}
:global(body){margin:0;background:#f7f6f2;color:#171717;font-family:Inter,ui-sans-serif,system-ui,-apple-system,"Segoe UI",sans-serif;line-height:1.55;padding-bottom:40px;opacity:0;transition:opacity .4s ease}
:global(body.is-ready){opacity:1}
:global(::selection){background:#2f708f;color:#fff}
:global(a:focus-visible),:global(button:focus-visible),:global(input:focus-visible),:global(select:focus-visible){outline:3px solid #2f708f;outline-offset:3px}
.skip-link{position:fixed;left:16px;top:12px;z-index:100;padding:9px 13px;border-radius:9px;background:#171717;color:#fff;text-decoration:none;font-size:13px;font-weight:800;transform:translateY(-160%);transition:transform .2s ease}.skip-link:focus{transform:translateY(0)}
header,footer,.hero{width:min(1180px,calc(100% - 44px));margin:auto}
header{padding:23px 0 18px;border-bottom:1px solid #d7d5ce;display:flex;justify-content:space-between;gap:20px}header a{color:#171717;text-decoration:none;font-size:12px;font-weight:800;letter-spacing:.1em}header a:last-child{color:#706d67;letter-spacing:0}header a:hover{color:#2f708f}
.hero{position:relative;overflow:hidden;padding:55px 0 65px}.hero>*:not(.hero-grid){position:relative;z-index:1}.hero-grid{position:absolute;inset:0 -8%;background-image:linear-gradient(rgba(49,112,143,.055) 1px,transparent 1px),linear-gradient(90deg,rgba(49,112,143,.055) 1px,transparent 1px);background-size:46px 46px;mask-image:linear-gradient(to bottom,transparent,black 12%,black 72%,transparent);pointer-events:none}
.meta{display:flex;justify-content:space-between;border-bottom:1px solid #d7d5ce;padding-bottom:17px;color:#77746e;font-size:11px;font-weight:800;letter-spacing:.13em}.eyebrow{margin:43px 0 12px;color:#31708f;font-size:12px;font-weight:800;letter-spacing:.16em}.hero h1{margin:0 0 24px;font-size:clamp(64px,9vw,126px);line-height:.84;letter-spacing:-.075em}.hero h1 em{font-family:Georgia,serif;color:#2f708f;font-weight:400}.intro{max-width:720px;color:#66635d;font-size:18px}
.card{width:min(920px,calc(100% - 44px));margin:auto;padding:34px 38px 42px;border:1px solid #d3d0c8;border-radius:22px;background:#fbfaf7;box-shadow:0 22px 70px rgba(35,35,30,.08);transition:box-shadow .25s ease,transform .25s ease}.card:hover{box-shadow:0 26px 78px rgba(35,35,30,.11);transform:translateY(-2px)}
.rule{display:grid;gap:4px;padding:18px 20px;margin-bottom:40px;background:#f0f6f8;border-left:3px solid #2f708f}.rule b{font-size:12px;color:#31708f;letter-spacing:.1em}.rule span{font-size:13px;color:#66635d}
.section{margin-bottom:43px}.section-head{display:flex;gap:16px;border-bottom:1px solid #ddd9d1;padding-bottom:16px;margin-bottom:22px}.section-head>span{color:#2f708f;font-size:11px;font-weight:800}.section-head small{display:block;color:#77746e;font-size:10px;font-weight:800;letter-spacing:.14em}.section-head h2{margin:4px 0 0;font-size:27px;letter-spacing:-.04em}
.fields{display:grid;grid-template-columns:1fr 1fr;gap:17px}.fields label,.conditional>label{color:#55524d;font-size:11px;font-weight:800}input,select{display:block;width:100%;margin-top:7px;border:1px solid #d3d0c8;border-radius:9px;background:#fffefa;color:#20201e;padding:13px 14px;font:inherit;font-size:14px;outline:none;transition:border-color .2s ease,box-shadow .2s ease,background .2s ease}input::placeholder{color:#aaa69f}input:hover,select:hover{border-color:#bbb7ae}input:focus,select:focus{border-color:#2f708f;box-shadow:0 0 0 3px rgba(47,112,143,.08);background:#fff}
.tracks{display:grid;gap:11px}.track{position:relative;display:grid;grid-template-columns:18px 1fr auto;gap:15px;padding:18px;border:1px solid #d7d4cc;border-radius:13px;background:#fffefa;cursor:pointer;transition:transform .2s ease,border-color .2s ease,background .2s ease,box-shadow .2s ease}.track:hover{transform:translateY(-2px);border-color:#bfcbd0;box-shadow:0 10px 24px rgba(35,35,30,.06)}.track input{position:absolute;opacity:0;pointer-events:none}.track i{width:17px;height:17px;border:1px solid #aaa69e;border-radius:50%;margin-top:3px;transition:border .2s ease,box-shadow .2s ease}.track:has(input:checked){border-color:#2f708f;background:#f1f7f9;box-shadow:0 8px 22px rgba(47,112,143,.08)}.track:has(input:checked) i{border:5px solid #2f708f;box-shadow:0 0 0 2px #fff}.track small,.track em{display:block;font-style:normal;color:#77746e;font-size:11px}.track b{display:block;margin:2px 0 3px}.track strong{font-size:12px;white-space:nowrap}
.conditional{padding:25px;border:1px solid #ddd9d1;border-radius:14px;background:#fffefa;margin-bottom:43px;animation:section-in .25s ease}.conditional>p{color:#66635d;font-size:13px}.choices{display:grid;grid-template-columns:1fr 1fr;gap:12px}.choices label{display:grid;grid-template-columns:22px 1fr;gap:4px 10px;padding:15px;border:1px solid #d7d4cc;border-radius:11px;cursor:pointer;transition:transform .2s ease,border-color .2s ease,background .2s ease}.choices label:hover{transform:translateY(-2px);border-color:#bfcbd0}.choices input{position:absolute;opacity:0;pointer-events:none}.choices span{grid-row:span 2;width:20px;height:20px;border:1px solid #aaa69e;border-radius:5px;text-align:center;color:transparent;line-height:18px}.choices b,.choices small{grid-column:2}.choices label:has(input:checked){border-color:#2f708f;background:#f1f7f9}.choices label:has(input:checked) span{border-color:#2f708f;background:#2f708f;color:#fff}
.summary{border:1px solid #ddd9d1;border-radius:13px;overflow:hidden}.summary div{display:flex;justify-content:space-between;gap:20px;padding:14px 16px;border-bottom:1px solid #eeeae3}.summary div:last-child{border-bottom:0}.summary span{color:#77746e;font-size:12px}.summary b{font-size:13px;text-align:right}
.consent{display:flex;gap:10px;align-items:flex-start;color:#66635d;font-size:13px}.consent input{width:18px;height:18px;margin:2px 0 0;accent-color:#2f708f}.consent span{flex:1}
button{position:relative;width:100%;margin-top:25px;border:0;border-radius:11px;padding:15px;background:#171717;color:white;font:inherit;font-weight:800;cursor:pointer;transition:transform .2s ease,background .2s ease,box-shadow .2s ease}button:not(:disabled):hover{background:#2f708f;transform:translateY(-1px);box-shadow:0 10px 24px rgba(47,112,143,.18)}button:disabled{opacity:.4;cursor:not-allowed}.spinner{display:none;width:17px;height:17px;margin:auto;border:2px solid rgba(255,255,255,.35);border-top-color:#fff;border-radius:50%;animation:spin .7s linear infinite}.spinner[aria-hidden="true"]{ }.button-arrow{margin-left:10px}button[data-loading] .spinner{display:block}button[data-loading] .button-label{position:absolute;left:-9999px}button[data-loading]{cursor:wait}
.state,.status{text-align:center;color:#66635d;font-size:13px;min-height:20px}.status.error{color:#b34034}.status:not(:empty){margin-top:6px;padding:10px 12px;border-radius:9px;background:#fff3f1}.state{margin-bottom:0}
footer{margin-top:75px;border-top:1px solid #d7d5ce;padding:22px 0;color:#77746e;font-size:11px;font-weight:700;display:flex;justify-content:space-between}
@keyframes spin{to{transform:rotate(360deg)}}@keyframes section-in{from{opacity:0;transform:translateY(-4px)}to{opacity:1;transform:none}}
@media(max-width:700px){:global(body){padding-bottom:25px}.fields,.choices{grid-template-columns:1fr}.card{width:min(100% - 30px,920px);padding:25px 20px}.hero{width:min(100% - 30px,1180px);padding:42px 0 48px}.hero h1{font-size:64px}.hero-grid{background-size:32px 32px}.meta,footer{gap:15px;flex-direction:column}.section-head h2{font-size:24px}.track{grid-template-columns:18px 1fr}.track strong{grid-column:2}.summary div{align-items:flex-start}.summary b{max-width:58%}}
@media(prefers-reduced-motion:reduce){:global(html){scroll-behavior:auto}:global(body),.card,input,select,.track,.choices label,button,.skip-link{transition:none}.conditional{animation:none}.spinner{animation:none}.hero-grid{display:none}}
</style>
<script>requestAnimationFrame(()=>document.body.classList.add('is-ready'));</script>
