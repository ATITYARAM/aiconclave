---
import ConclavePage from '../layouts/ConclavePage.astro';
---
<ConclavePage title="Registration" eyebrow="Registration" heading="Choose your track." intro="Registration is organised around three distinct tracks. Select one track and follow its participation and fee rules.">
  <div class="grid"><div class="card"><small>Track 01</small><h3>Innovation Showcase</h3><p>KEC students &amp; faculty · Free.</p></div><div class="card"><small>Track 02</small><h3>Innovation Challenge</h3><p>Registered teams / external participants · Free / nominal cost.</p></div><div class="card"><small>Track 03</small><h3>Hands-on Workshops</h3><p>₹300 for one workshop · ₹500 for both workshops.</p></div></div>
  <div class="rules"><strong>One-track rule</strong><span>Cross-participation between Showcase, Challenge and Workshops is not permitted.</span><span>Workshop participants may select one or both workshops.</span></div>
  <p style="margin-top:30px"><a href="/aiconclave/" style="color:#2f708f;font-weight:800">← Return to the main page</a></p>
</ConclavePage>
