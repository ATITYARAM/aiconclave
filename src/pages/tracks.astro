---
import ConclavePage from '../layouts/ConclavePage.astro';
const tracks=[['01','HPC Industry Innovation Showcase','KEC students & faculty','Free','Bring and demonstrate a completed / working solution.'],['02','HPC Industry Innovation Challenge','Registered challenge teams / external participants','Free / nominal cost','24-hour competitive challenge to solve a real industry problem.'],['03','Hands-on Workshops','General registered participants','₹300 one · ₹500 both','GPU Computing & CUDA; Generative AI & LLMs on HPC.']];
---
<ConclavePage title="Tracks" eyebrow="Three Tracks" heading="Choose how you participate." intro="The conclave is organised into three distinct participation tracks. Cross-participation between tracks is not permitted.">
  <div class="big-list">{tracks.map(([num,title,who,fee,detail])=><div class="row"><span class="num">{num}</span><div><small>{who}</small><h3>{title}</h3><p>{detail}</p></div><strong class="fee">{fee}</strong></div>)}</div>
</ConclavePage>
