---
import ConclavePage from '../layouts/ConclavePage.astro';

const workshops = [
  {
    number: '01',
    title: 'GPU Computing & CUDA',
    day: '05 February 2027 · Friday',
    time: '2:15 PM – 4:15 PM'
  },
  {
    number: '02',
    title: 'Generative AI & LLMs on HPC',
    day: '06 February 2027 · Saturday',
    time: '9:00 AM – 12:30 PM'
  }
];

const rules = [
  'Open to general registered participants.',
  'Challenge participants cannot participate in the Hands-on Workshops.',
  'Participants should attend the workshop start promptly, as hands-on exercises build sequentially.',
  'Bring your own laptop unless informed otherwise by the organizing committee.',
  'Seats may be limited; prior registration is recommended.'
];
---

<ConclavePage
  title="Workshops"
  eyebrow="Track 03 · Hands-on Workshops"
  heading="Hands-on Workshops"
  intro="A skill-development programme with two paid workshops: GPU Computing & CUDA and Generative AI & LLMs on HPC."
>
  <section class="workshop-grid" aria-label="Hands-on workshops">
    {workshops.map((workshop) => (
      <article class={`workshop-card workshop-${workshop.number}`}>
        <div class="card-top">
          <span class="number">{workshop.number}</span>
          <span class="tag">Hands-on Workshop</span>
        </div>

        <h2>{workshop.title}</h2>

        <div class="schedule">
          <div class="schedule-item">
            <span class="schedule-label">DATE</span>
            <strong>{workshop.day}</strong>
          </div>
          <div class="schedule-item">
            <span class="schedule-label">TIME</span>
            <strong>{workshop.time}</strong>
          </div>
        </div>
      </article>
    ))}
  </section>

  <section class="fee-panel" aria-label="Registration fees">
    <div class="fee-heading">
      <span class="panel-label">REGISTRATION FEES</span>
      <h2>Workshop Participation</h2>
    </div>
    <div class="fee-options">
      <div class="fee-option">
        <strong>₹300</strong>
        <span>One Workshop</span>
      </div>
      <div class="fee-option featured">
        <strong>₹500</strong>
        <span>Both Workshops</span>
      </div>
    </div>
  </section>

  <section class="rules-panel" aria-label="Workshop participation rules">
    <div class="rules-heading">
      <span class="info-mark">i</span>
      <div>
        <span class="panel-label">IMPORTANT INFORMATION</span>
        <h2>Workshop Participation Rules</h2>
      </div>
    </div>

    <ul>
      {rules.map((rule) => <li>{rule}</li>)}
    </ul>
  </section>
</ConclavePage>

<style>
  .workshop-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 30px;
  }

  .workshop-card {
    position: relative;
    overflow: hidden;
    min-height: 390px;
    padding: 30px 32px 34px;
    border: 1px solid rgba(18, 23, 31, 0.95);
    border-radius: 26px;
    background: rgba(12, 16, 22, 0.96);
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.4), 0 5px 18px rgba(0, 0, 0, 0.4);
    transform: translateY(0);
    transition: transform 220ms ease, box-shadow 220ms ease;
  }

  .workshop-card:hover {
    transform: translateY(-10px);
    box-shadow: 0 34px 72px rgba(0, 0, 0, 0.4), 0 8px 24px rgba(0, 0, 0, 0.4);
  }

  .workshop-card::after {
    content: '';
    position: absolute;
    right: -55px;
    bottom: -75px;
    width: 210px;
    height: 170px;
    border-radius: 50% 0 0 0;
    background: linear-gradient(135deg, rgba(63, 210, 196, 0.08), rgba(63, 210, 196, 0.14));
    pointer-events: none;
  }

  .workshop-02::after {
    background: linear-gradient(135deg, rgba(63, 210, 196, 0.08), rgba(63, 210, 196, 0.14));
  }

  .card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
  }

  .number {
    display: inline-grid;
    place-items: center;
    width: 58px;
    height: 46px;
    border-radius: 16px;
    background: #121a24;
    color: #3fd2c4;
    font-size: 17px;
    font-weight: 800;
  }

  .workshop-02 .number {
    background: #141c2a;
    color: #35b8ab;
  }

  .tag {
    padding: 9px 14px;
    border-radius: 999px;
    background: #121a24;
    color: #3fd2c4;
    font-size: 12px;
    font-weight: 800;
  }

  .workshop-02 .tag {
    background: #141c2a;
    color: #35b8ab;
  }

  .workshop-card h2 {
    position: relative;
    z-index: 1;
    margin: 28px 0 30px;
    max-width: 520px;
    font-size: clamp(30px, 3vw, 42px);
    line-height: 1.08;
    letter-spacing: -0.055em;
  }

  .schedule {
    position: relative;
    z-index: 1;
    display: grid;
    gap: 20px;
    padding-top: 24px;
    border-top: 1px solid #232b36;
  }

  .schedule-item {
    display: grid;
    gap: 5px;
  }

  .schedule-label,
  .panel-label {
    color: #96a0ac;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.16em;
  }

  .schedule-item strong {
    color: #e9eef4;
    font-size: 17px;
    font-weight: 600;
  }

  .fee-panel {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 30px;
    align-items: center;
    margin-top: 26px;
    padding: 24px 28px;
    border: 1px solid #232b36;
    border-radius: 22px;
    background: linear-gradient(110deg, #121a26, #12171f);
  }

  .fee-heading h2,
  .rules-heading h2 {
    margin: 5px 0 0;
    color: #e9eef4;
    font-size: clamp(25px, 3vw, 36px);
    line-height: 1.05;
    letter-spacing: -0.045em;
  }

  .fee-options {
    display: grid;
    grid-template-columns: repeat(2, 170px);
    gap: 14px;
  }

  .fee-option {
    display: grid;
    justify-items: center;
    gap: 2px;
    padding: 16px 12px;
    border: 1px solid #232b36;
    border-radius: 15px;
    background: #121a24;
  }

  .fee-option.featured {
    border-color: #2a3342;
    background: #121a26;
  }

  .fee-option strong {
    color: #3fd2c4;
    font-size: 30px;
    line-height: 1;
    letter-spacing: -0.04em;
  }

  .fee-option.featured strong {
    color: #35b8ab;
  }

  .fee-option span {
    color: #2a3342;
    font-size: 14px;
  }

  .rules-panel {
    margin-top: 26px;
    padding: 30px 32px 32px;
    border: 1px solid #232b36;
    border-radius: 22px;
    background: #12171f;
  }

  .rules-heading {
    display: flex;
    align-items: center;
    gap: 18px;
  }

  .info-mark {
    display: grid;
    flex: 0 0 52px;
    place-items: center;
    width: 52px;
    height: 52px;
    border-radius: 50%;
    background: #121a24;
    color: #3fd2c4;
    font-size: 23px;
    font-weight: 800;
  }

  .rules-panel ul {
    display: grid;
    gap: 13px;
    margin: 27px 0 0;
    padding: 0;
    list-style: none;
  }

  .rules-panel li {
    position: relative;
    padding-left: 34px;
    color: #e9eef4;
    font-size: 16px;
    line-height: 1.65;
  }

  .rules-panel li::before {
    content: '✓';
    position: absolute;
    left: 0;
    top: 2px;
    display: grid;
    place-items: center;
    width: 21px;
    height: 21px;
    border-radius: 50%;
    background: #121a24;
    color: #3fd2c4;
    font-size: 12px;
    font-weight: 900;
  }

  @media (max-width: 760px) {
    .workshop-grid,
    .fee-panel {
      grid-template-columns: 1fr;
    }

    .workshop-card {
      min-height: auto;
      padding: 24px;
      border-radius: 20px;
    }

    .workshop-card:hover {
      transform: translateY(-5px);
    }

    .workshop-card h2 {
      margin: 24px 0;
      font-size: 31px;
    }

    .fee-panel,
    .rules-panel {
      padding: 24px;
      border-radius: 18px;
    }

    .fee-options {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .rules-heading {
      align-items: flex-start;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .workshop-card {
      transition: none;
    }
  }
</style>
